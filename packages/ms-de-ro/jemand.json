    "headword": "jemand",
    "definition": "Eine nicht näher bestimmte Person.",
    "pronunciation": "/ˈjeːmant/",
    "etymology": {
      "explanation": {
        "sourceText": "„Jemand“ entstand aus mittelhochdeutsch „ieman“, wörtlich „irgendein Mann, irgendwer“.",
        "targetText": "„Jemand” provine din germana medie „ieman”, literal „vreun om, oricine”."
      },
      "source": "Etymological Dictionaries, Linguistic Analysis"
    }
  },
  "target": {
    "lang": "ro",
    "headword": "cineva",
    "definition": "O persoană nedeterminată.",
    "pronunciation": "/t͡ʃi.neˈva/",
    "etymology": {
      "explanation": {
        "sourceText": "Das rumänische „cineva“ ist aus „cine“ (< lateinisch „quinam“, wer denn) und der Partikel „-va“ gebildet.",
        "targetText": "Românescul „cineva” este format din „cine” (din latinescul „quinam”) și particula „-va”."
      },
      "source": "Etymological Dictionaries, Linguistic Analysis"
    }
  },
