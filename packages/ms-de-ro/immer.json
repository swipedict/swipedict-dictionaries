  "learningTips": [
    {
      "lang": "de",
      "text": "Kürzere Alternative im Alltag: „mereu“ – gleiche Bedeutung, weniger Silben."
    },
    {
      "lang": "de",
      "text": "Das lange Wort zerlegt sich in „în-tot-de-a-una“ – „zu jeder einzelnen Zeit“."
