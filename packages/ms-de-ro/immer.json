  "source": {
    "lang": "de",
    "headword": "immer",
    "definition": "Zu jeder Zeit, ohne Ausnahme.",
    "pronunciation": "/ˈɪmɐ/",
    "etymology": {
      "explanation": {
        "sourceText": "„Immer“ entstand aus althochdeutsch „io mēr“ – „je mehr, allezeit“.",
        "targetText": "„Immer” provine din germana veche înaltă „io mēr” – „mereu, oricând”."
      },
      "source": "Etymological Dictionaries, Linguistic Analysis"
    }
  },
  "target": {
    "lang": "ro",
    "headword": "întotdeauna",
    "definition": "În orice moment, fără excepție.",
    "pronunciation": "/ɨn.to.deaˈu.na/",
    "etymology": {
      "explanation": {
        "sourceText": "Das rumänische „întotdeauna“ ist eine Zusammensetzung aus „în“, „tot“ (< lateinisch „totus“), „de“ und „una“ (< lateinisch „una“).",
        "targetText": "Românescul „întotdeauna” este un compus din „în”, „tot” (din latinescul „totus”), „de” și „una”."
      },
      "source": "Etymological Dictionaries, Linguistic Analysis"
    }
  },
