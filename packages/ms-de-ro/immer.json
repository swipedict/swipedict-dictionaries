  "examples": [
    {
      "sourceText": "Ich stehe immer früh auf.",
      "targetText": "Mă trezesc întotdeauna devreme."
    },
    {
      "sourceText": "Er ist immer freundlich.",
      "targetText": "El este întotdeauna prietenos."
    },
    {
      "sourceText": "Wie immer.",
      "targetText": "Ca întotdeauna."
    },
    {
      "sourceText": "Das war schon immer so.",
      "targetText": "A fost întotdeauna așa."
    }
