  "source": {
    "lang": "de",
    "headword": "Freude",
    "definition": "Angenehmes Gefühl bei etwas Schönem.",
    "pronunciation": "/ˈfʁɔɪ̯də/",
    "etymology": {
      "explanation": {
        "sourceText": "„Freude“ ist von „froh“ abgeleitet, althochdeutsch „frewida“.",
        "targetText": "„Freude” este derivat de la „froh”, în germana veche înaltă „frewida”."
      },
      "source": "Etymological Dictionaries, Linguistic Analysis"
    },
    "genus": "feminine"
  },
  "target": {
    "lang": "ro",
    "headword": "bucurie",
    "definition": "Sentiment plăcut provocat de ceva frumos.",
    "pronunciation": "/bu.kuˈri.e/",
    "etymology": {
      "explanation": {
        "sourceText": "Das rumänische „bucurie“ gehört zu „a bucura“, das aus dem vorrömischen Substrat stammt; man vergleicht albanisch „bukurë“ („schön“).",
        "targetText": "Românescul „bucurie” este legat de „a bucura”, cuvânt din substratul preroman; se compară cu albanezul „bukurë” („frumos”)."
      },
      "source": "Etymological Dictionaries, Linguistic Analysis"
    },
    "genus": "feminine"
  },
