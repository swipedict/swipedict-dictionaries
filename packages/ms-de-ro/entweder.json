  "source": {
    "lang": "de",
    "headword": "entweder",
    "definition": "Erster Teil der Doppelkonjunktion „entweder … oder“.",
    "pronunciation": "/ɛntˈveːdɐ/",
    "etymology": {
      "explanation": {
        "sourceText": "„Entweder“ geht auf mittelhochdeutsch „eintweder“ zurück – „eines von beiden“.",
        "targetText": "„Entweder” provine din germana medie „eintweder” – „unul dintre doi”."
      },
      "source": "Etymological Dictionaries, Linguistic Analysis"
    }
  },
  "target": {
    "lang": "ro",
    "headword": "fie … fie",
    "definition": "Prima parte a construcției corelative „fie … fie”.",
    "pronunciation": "/fi.e fi.e/",
    "etymology": {
      "explanation": {
        "sourceText": "Das rumänische „fie“ ist der Konjunktiv von „a fi“ (< lateinisch „fieri“, werden) und heißt wörtlich „es sei“.",
        "targetText": "Românescul „fie” este conjunctivul verbului „a fi” (din latinescul „fieri”) și înseamnă literal „să fie”."
      },
      "source": "Etymological Dictionaries, Linguistic Analysis"
    }
  },
  "senses": [],
  "relatedWords": [
    {
      "sourceText": "oder",
      "targetText": "sau"
    },
    {
      "sourceText": "sowohl … als auch",
      "targetText": "atât … cât și"
    },
    {
      "sourceText": "ob … oder",
      "targetText": "ori … ori"
    }
  ],
  "antonyms": [
    {
      "sourceText": "sowohl … als auch",
      "targetText": "atât … cât și"
