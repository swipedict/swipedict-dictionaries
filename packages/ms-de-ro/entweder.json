  ],
  "examples": [
    {
      "sourceText": "Entweder heute oder morgen.",
      "targetText": "Fie astăzi, fie mâine."
    },
    {
      "sourceText": "Entweder du oder ich.",
      "targetText": "Fie tu, fie eu."
    },
    {
      "sourceText": "Entweder Kaffee oder Tee.",
      "targetText": "Fie cafea, fie ceai."
    },
    {
      "sourceText": "Entweder er kommt oder er ruft an.",
      "targetText": "Fie vine, fie sună."
    }
  ],
  "learningTips": [
    {
      "lang": "de",
      "text": "Gleichwertige Alternative: „ori … ori“ – etwas umgangssprachlicher als „fie … fie“."
    },
    {
      "lang": "de",
      "text": "„fie“ ist wörtlich „es sei“ – daher auch in „fie ce-o fi“ (komme, was wolle)."
    }
  ],
