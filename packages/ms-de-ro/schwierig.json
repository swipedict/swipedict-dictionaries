  "source": {
    "lang": "de",
    "headword": "schwierig",
    "definition": "Nicht leicht zu tun oder zu verstehen.",
    "pronunciation": "/ˈʃviːʁɪç/",
    "etymology": {
      "explanation": {
        "sourceText": "„Schwierig“ ist von „schwer“ abgeleitet, über mittelhochdeutsch „swiric“.",
        "targetText": "„Schwierig” este derivat de la „schwer”, prin germana medie „swiric”."
      },
      "source": "Etymological Dictionaries, Linguistic Analysis"
    }
  },
  "target": {
    "lang": "ro",
    "headword": "dificil",
    "definition": "Care nu este ușor de făcut sau de înțeles.",
    "pronunciation": "/di.fiˈt͡ʃil/",
    "etymology": {
      "explanation": {
        "sourceText": "Das rumänische „dificil“ ist aus dem Französischen „difficile“ entlehnt; die lateinische Wurzel ist „difficilis“ („nicht leicht zu machen“).",
        "targetText": "Românescul „dificil” este împrumutat din franceză, din „difficile”; rădăcina latină este „difficilis” („greu de făcut”)."
      },
      "source": "Etymological Dictionaries, Linguistic Analysis"
    }
  },
