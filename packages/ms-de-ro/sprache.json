    "etymology": {
      "explanation": {
        "sourceText": "„Sprache“ ist vom Verb „sprechen“ abgeleitet, althochdeutsch „sprāhha“.",
        "targetText": "„Sprache” este derivat de la verbul „sprechen”, în germana veche înaltă „sprāhha”."
      },
