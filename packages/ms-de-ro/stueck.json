  "source": {
    "lang": "de",
    "headword": "Stück",
    "definition": "Ein abgetrennter Teil eines Ganzen.",
    "pronunciation": "/ʃtʏk/",
    "etymology": {
      "explanation": {
        "sourceText": "„Stück“ geht auf althochdeutsch „stucki“ zurück, verwandt mit „Stock“ – ursprünglich ein abgeschlagenes Teil.",
        "targetText": "„Stück” provine din germana veche înaltă „stucki”, înrudit cu „Stock” – inițial o parte retezată."
      },
      "source": "Etymological Dictionaries, Linguistic Analysis"
    },
    "genus": "neuter"
  },
  "target": {
    "lang": "ro",
    "headword": "bucată",
    "definition": "O parte desprinsă dintr-un întreg.",
    "pronunciation": "/buˈka.tə/",
    "etymology": {
      "explanation": {
        "sourceText": "Das rumänische „bucată“ ist slawischen Ursprungs und geht auf eine Wurzel „bǫk-“ („Stück, Brocken“) zurück.",
        "targetText": "Românescul „bucată” este de origine slavă și provine dintr-o rădăcină „bǫk-” („bucată, fragment”)."
      },
      "source": "Etymological Dictionaries, Linguistic Analysis"
    },
    "genus": "feminine"
  },
