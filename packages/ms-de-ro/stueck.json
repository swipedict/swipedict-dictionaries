  "examples": [
    {
      "sourceText": "Ein Stück Brot.",
      "targetText": "O bucată de pâine."
    },
    {
      "sourceText": "Zwei Stück, bitte.",
      "targetText": "Două bucăți, vă rog."
    },
    {
      "sourceText": "Ein Stück Kuchen.",
      "targetText": "O bucată de tort."
    },
    {
      "sourceText": "Er hat es in Stücke zerbrochen.",
      "targetText": "L-a rupt în bucăți."
    }
  ],
  "learningTips": [
    {
      "lang": "de",
      "text": "Plural: „bucăți“. Beim Einkaufen zählt man damit Stückware: „trei bucăți“."
    },
    {
      "lang": "de",
      "text": "Von „bucată“ kommt auch „bucătărie“ (Küche) – der Ort, wo zerteilt wird."
    }
