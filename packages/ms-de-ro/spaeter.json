  "source": {
    "lang": "de",
    "headword": "später",
    "definition": "Zu einem Zeitpunkt nach jetzt.",
    "pronunciation": "/ˈʃpɛːtɐ/",
    "etymology": {
      "explanation": {
        "sourceText": "„Später“ ist der Komparativ von „spät“, althochdeutsch „spāti“.",
        "targetText": "„Später” este comparativul lui „spät”, în germana veche înaltă „spāti”."
      },
      "source": "Etymological Dictionaries, Linguistic Analysis"
    }
  },
  "target": {
    "lang": "ro",
    "headword": "mai târziu",
    "definition": "La un moment de după cel prezent.",
    "pronunciation": "/maj tɨrˈziw/",
    "etymology": {
      "explanation": {
        "sourceText": "Die rumänische Fügung verbindet „mai“ (< lateinisch „magis“) mit „târziu“ (< lateinisch „tardivus“).",
        "targetText": "Construcția românească leagă „mai” (din latinescul „magis”) cu „târziu” (din „tardivus”)."
      },
      "source": "Etymological Dictionaries, Linguistic Analysis"
    }
  },
