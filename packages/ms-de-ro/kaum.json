  "examples": [
    {
      "sourceText": "Ich kann ihn kaum hören.",
      "targetText": "Îl aud cu greu."
    },
    {
      "sourceText": "Er kam kaum voran.",
      "targetText": "Înainta cu greu."
    },
    {
      "sourceText": "Kaum jemand war da.",
      "targetText": "Aproape nimeni nu era acolo."
    },
    {
      "sourceText": "Sie kann kaum laufen.",
      "targetText": "Merge cu greu."
    }
  ],
  "learningTips": [
    {
      "lang": "de",
      "text": "Für „kaum jemand / kaum etwas“ nimmt man „aproape nimeni / aproape nimic“."
    },
    {
      "lang": "de",
      "text": "„cu greu“ ist wörtlich „mit Schwierigkeit“ – wie deutsch „mit Mühe“."
    }
