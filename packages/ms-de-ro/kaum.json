  "source": {
    "lang": "de",
    "headword": "kaum",
    "definition": "Nur mit Mühe; fast gar nicht.",
    "pronunciation": "/kaʊ̯m/",
    "etymology": {
      "explanation": {
        "sourceText": "„Kaum“ geht auf althochdeutsch „kūmo“ („mühsam, klagend“) zurück.",
        "targetText": "„Kaum” provine din germana veche înaltă „kūmo” („cu greu, tânguitor”)."
      },
      "source": "Etymological Dictionaries, Linguistic Analysis"
    }
  },
  "target": {
    "lang": "ro",
    "headword": "cu greu",
    "definition": "Numai cu efort; aproape deloc.",
    "pronunciation": "/ku ɡrew/",
    "etymology": {
      "explanation": {
        "sourceText": "Die Fügung „cu greu“ enthält „greu“, das auf vulgärlateinisch „grevis“ (klassisch „gravis“, schwer) zurückgeht.",
        "targetText": "Construcția „cu greu” conține „greu”, din latinescul popular „grevis” (clasic „gravis”, greu)."
      },
      "source": "Etymological Dictionaries, Linguistic Analysis"
    }
  },
