  "source": {
    "lang": "de",
    "headword": "schwer",
    "definition": "Von großem Gewicht; auch: schwierig.",
    "pronunciation": "/ʃveːɐ̯/",
    "etymology": {
      "explanation": {
        "sourceText": "„Schwer“ geht auf althochdeutsch „swār“ zurück, ein gemeingermanisches Wort.",
        "targetText": "„Schwer” provine din germana veche înaltă „swār”, cuvânt comun germanic."
      },
      "source": "Etymological Dictionaries, Linguistic Analysis"
    }
  },
  "target": {
    "lang": "ro",
    "headword": "greu",
    "definition": "Care are o greutate mare; de asemenea: dificil.",
    "pronunciation": "/ɡrew/",
    "etymology": {
      "explanation": {
        "sourceText": "Das rumänische „greu“ geht auf vulgärlateinisch „grevis“ (klassisch „gravis“) zurück – dieselbe Wurzel wie in „gravitate“.",
        "targetText": "Românescul „greu” provine din latinescul popular „grevis” (clasic „gravis”) – aceeași rădăcină ca în „gravitate”."
      },
      "source": "Etymological Dictionaries, Linguistic Analysis"
    }
  },
