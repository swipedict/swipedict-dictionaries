  "examples": [
    {
      "sourceText": "Möchtest du Tee?",
      "targetText": "Vrei ceai?"
    },
    {
      "sourceText": "Ein Tee mit Zitrone.",
      "targetText": "Un ceai cu lămâie."
    },
    {
      "sourceText": "Der Tee ist zu heiß.",
      "targetText": "Ceaiul este prea fierbinte."
    },
    {
