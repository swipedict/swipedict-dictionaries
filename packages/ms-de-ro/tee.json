  "source": {
    "lang": "de",
    "headword": "Tee",
    "definition": "Heißes Getränk aus aufgegossenen Blättern oder Kräutern.",
    "pronunciation": "/teː/",
    "etymology": {
      "explanation": {
        "sourceText": "„Tee“ kam über niederländisch „thee“ aus dem südchinesischen „te“.",
        "targetText": "„Tee” a ajuns prin olandezul „thee” din chinezescul sudic „te”."
      },
      "source": "Etymological Dictionaries, Linguistic Analysis"
    },
    "genus": "masculine"
  },
  "target": {
    "lang": "ro",
    "headword": "ceai",
    "definition": "Băutură fierbinte obținută prin infuzarea frunzelor sau plantelor.",
    "pronunciation": "/t͡ʃaj/",
    "etymology": {
      "explanation": {
        "sourceText": "Das rumänische „ceai“ stammt aus dem Russischen „čaj“, das auf das nordchinesische „chá“ zurückgeht – ein anderer Weg als beim deutschen „Tee“.",
        "targetText": "Românescul „ceai” provine din rusescul „čaj”, care merge înapoi la chinezescul nordic „chá” – alt drum decât germanul „Tee”."
      },
      "source": "Etymological Dictionaries, Linguistic Analysis"
    },
    "genus": "neuter"
  },
