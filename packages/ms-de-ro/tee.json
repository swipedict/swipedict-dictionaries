  "learningTips": [
    {
      "lang": "de",
      "text": "Schön zu wissen: „Tee“ und „ceai“ kommen beide aus dem Chinesischen – über den Seeweg bzw. über die Landroute."
    },
    {
      "lang": "de",
      "text": "„ceai“ ist sächlich: „un ceai bun“, Plural „ceaiuri“."
    }
