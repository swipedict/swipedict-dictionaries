  "source": {
    "lang": "de",
    "headword": "offen",
    "definition": "Nicht geschlossen; zugänglich.",
    "pronunciation": "/ˈɔfn̩/",
    "etymology": {
      "explanation": {
        "sourceText": "„Offen“ geht auf althochdeutsch „offan“ zurück, verwandt mit „auf“.",
        "targetText": "„Offen” provine din germana veche înaltă „offan”, înrudit cu „auf”."
      },
      "source": "Etymological Dictionaries, Linguistic Analysis"
    }
  },
  "target": {
    "lang": "ro",
    "headword": "deschis",
    "definition": "Care nu este închis; accesibil.",
    "pronunciation": "/desˈkis/",
    "etymology": {
      "explanation": {
        "sourceText": "Das rumänische „deschis“ ist das Partizip von „a deschide“, das auf lateinisch „discludere“ („aufschließen“) zurückgeht.",
        "targetText": "Românescul „deschis” este participiul verbului „a deschide”, din latinescul „discludere” („a descuia”)."
      },
      "source": "Etymological Dictionaries, Linguistic Analysis"
    }
  },
