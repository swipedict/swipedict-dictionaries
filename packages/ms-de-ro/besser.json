  "source": {
    "lang": "de",
    "headword": "besser",
    "definition": "Von höherer Qualität; Komparativ zu „gut“.",
    "pronunciation": "/ˈbɛsɐ/",
    "etymology": {
      "explanation": {
        "sourceText": "„Besser“ ist der unregelmäßige Komparativ zu „gut“, althochdeutsch „bezziro“.",
        "targetText": "„Besser” este comparativul neregulat al lui „gut”, în germana veche înaltă „bezziro”."
      },
      "source": "Etymological Dictionaries, Linguistic Analysis"
    }
  },
  "target": {
    "lang": "ro",
    "headword": "mai bine",
    "definition": "De o calitate superioară; comparativul lui „bine”.",
    "pronunciation": "/maj ˈbi.ne/",
    "etymology": {
      "explanation": {
        "sourceText": "Die Fügung verbindet „mai“ (< lateinisch „magis“) mit „bine“ (< lateinisch „bene“).",
        "targetText": "Construcția leagă „mai” (din latinescul „magis”) cu „bine” (din latinescul „bene”)."
      },
      "source": "Etymological Dictionaries, Linguistic Analysis"
    }
  },
