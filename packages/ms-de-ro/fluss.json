  "source": {
    "lang": "de",
    "headword": "Fluss",
    "definition": "Größeres fließendes Gewässer.",
    "pronunciation": "/flʊs/",
    "etymology": {
      "explanation": {
        "sourceText": "„Fluss“ ist von „fließen“ abgeleitet, althochdeutsch „fliozan“.",
        "targetText": "„Fluss” este derivat de la „fließen”, în germana veche înaltă „fliozan”."
      },
      "source": "Etymological Dictionaries, Linguistic Analysis"
    },
    "genus": "masculine"
  },
  "target": {
    "lang": "ro",
    "headword": "râu",
    "definition": "Curs de apă mai mare care curge.",
    "pronunciation": "/rɨw/",
    "etymology": {
      "explanation": {
        "sourceText": "Das rumänische „râu“ stammt vom lateinischen „rivus“ („Bach“) – dieselbe Wurzel wie in „Rivale“, ursprünglich „Bachnachbar“.",
        "targetText": "Românescul „râu” provine din latinescul „rivus” („pârâu”) – aceeași rădăcină ca în „rival”, inițial „vecin de râu”."
      },
      "source": "Etymological Dictionaries, Linguistic Analysis"
    },
    "genus": "neuter"
  },
