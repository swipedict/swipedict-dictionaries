  "source": {
    "lang": "de",
    "headword": "niemand",
    "definition": "Keine einzige Person.",
    "pronunciation": "/ˈniːmant/",
    "etymology": {
      "explanation": {
        "sourceText": "„Niemand“ entstand aus mittelhochdeutsch „nieman“, aus „ni“ (nicht) und „man“ (Mensch).",
        "targetText": "„Niemand” provine din germana medie „nieman”, din „ni” (nu) și „man” (om)."
      },
      "source": "Etymological Dictionaries, Linguistic Analysis"
    }
  },
  "target": {
    "lang": "ro",
    "headword": "nimeni",
    "definition": "Nicio persoană.",
    "pronunciation": "/ˈni.menʲ/",
    "etymology": {
      "explanation": {
        "sourceText": "Das rumänische „nimeni“ geht auf lateinisch „nemo“ zurück, beeinflusst von „cine“.",
        "targetText": "Românescul „nimeni” provine din latinescul „nemo”, cu influența lui „cine”."
      },
      "source": "Etymological Dictionaries, Linguistic Analysis"
    }
  },
