  "source": {
    "lang": "de",
    "headword": "Sache",
    "definition": "Angelegenheit, Thema oder Frage, um die es geht.",
    "pronunciation": "/ˈzaxə/",
    "etymology": {
      "explanation": {
        "sourceText": "„Sache“ geht auf althochdeutsch „sahha“ („Rechtsstreit“) zurück – wie „Ding“ ein Wort aus der Gerichtssprache.",
        "targetText": "„Sache” provine din germana veche înaltă „sahha” („proces”) – ca și „Ding”, un cuvânt din limbajul juridic."
      },
      "source": "Etymological Dictionaries, Linguistic Analysis"
    },
    "genus": "feminine"
  },
  "target": {
    "lang": "ro",
    "headword": "chestiune",
    "definition": "Problemă, temă sau aspect despre care este vorba.",
    "pronunciation": "/kes.tiˈu.ne/",
    "etymology": {
      "explanation": {
        "sourceText": "Das rumänische „chestiune“ ist aus dem Französischen „question“ entlehnt; die lateinische Wurzel „quaestio“ heißt „Untersuchung“.",
        "targetText": "Românescul „chestiune” este împrumutat din franceză, din „question”; rădăcina latină „quaestio” înseamnă „cercetare”."
      },
      "source": "Etymological Dictionaries, Linguistic Analysis"
    },
    "genus": "feminine"
  },
