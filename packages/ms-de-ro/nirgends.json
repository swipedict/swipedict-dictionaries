  "source": {
    "lang": "de",
    "headword": "nirgends",
    "definition": "An keinem einzigen Ort.",
    "pronunciation": "/ˈnɪʁɡn̩t͡s/",
    "etymology": {
      "explanation": {
        "sourceText": "„Nirgends“ entstand aus mittelhochdeutsch „niergen“, aus „ni“ (nicht) und „ergen“ (irgendwo).",
        "targetText": "„Nirgends” provine din germana medie „niergen”, din „ni” (nu) și „ergen” (undeva)."
      },
      "source": "Etymological Dictionaries, Linguistic Analysis"
    }
  },
  "target": {
    "lang": "ro",
    "headword": "nicăieri",
    "definition": "În niciun loc.",
    "pronunciation": "/ni.kəˈjerʲ/",
    "etymology": {
      "explanation": {
        "sourceText": "Das rumänische „nicăieri“ ist aus „nici“ (< lateinisch „neque“) und „căieri“ (< lateinisch „qua“) gebildet.",
        "targetText": "Românescul „nicăieri” este format din „nici” (din latinescul „neque”) și „căieri” (din latinescul „qua”)."
      },
      "source": "Etymological Dictionaries, Linguistic Analysis"
    }
  },
