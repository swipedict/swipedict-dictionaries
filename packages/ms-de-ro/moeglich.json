  "source": {
    "lang": "de",
    "headword": "möglich",
    "definition": "Was geschehen oder getan werden kann.",
    "pronunciation": "/ˈmøːklɪç/",
    "etymology": {
      "explanation": {
        "sourceText": "„Möglich“ ist von „mögen“ (können) abgeleitet, mittelhochdeutsch „mügelich“.",
        "targetText": "„Möglich” este derivat de la „mögen” (a putea), în germana medie „mügelich”."
      },
      "source": "Etymological Dictionaries, Linguistic Analysis"
    }
  },
  "target": {
    "lang": "ro",
    "headword": "posibil",
    "definition": "Care se poate întâmpla sau realiza.",
    "pronunciation": "/poˈsi.bil/",
    "etymology": {
      "explanation": {
        "sourceText": "Das rumänische „posibil“ ist aus dem Französischen „possible“ entlehnt; die lateinische Wurzel „possibilis“ gehört zu „posse“ („können“).",
        "targetText": "Românescul „posibil” este împrumutat din franceză, din „possible”; rădăcina latină „possibilis” vine de la „posse” („a putea”)."
      },
      "source": "Etymological Dictionaries, Linguistic Analysis"
    }
  },
