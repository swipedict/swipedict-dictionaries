  "source": {
    "lang": "de",
    "headword": "sollen",
    "definition": "Eine Verpflichtung oder Erwartung ausdrücken.",
    "pronunciation": "/ˈzɔlən/",
    "etymology": {
      "explanation": {
        "sourceText": "„Sollen“ geht auf althochdeutsch „scolan“ zurück, ursprünglich „schulden“ – wer soll, der schuldet etwas.",
        "targetText": "„Sollen” provine din germana veche înaltă „scolan”, inițial „a datora” – cine trebuie, acela datorează ceva."
      },
      "source": "Etymological Dictionaries, Linguistic Analysis"
    }
  },
  "target": {
    "lang": "ro",
    "headword": "a trebui",
    "definition": "A exprima o obligație sau o așteptare.",
    "pronunciation": "/a treˈbuj/",
    "etymology": {
      "explanation": {
        "sourceText": "Das rumänische „a trebui“ stammt aus altkirchenslawisch „trěbovati“ („bedürfen“) und wird meist unpersönlich gebraucht.",
        "targetText": "Românescul „a trebui” provine din slavona veche „trěbovati” („a avea nevoie”) și se folosește mai ales impersonal."
      },
      "source": "Etymological Dictionaries, Linguistic Analysis"
    }
  },
  "senses": [],
  "relatedWords": [
    {
      "sourceText": "müssen",
      "targetText": "a trebui"
    },
    {
