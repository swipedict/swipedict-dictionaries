  "antonyms": [],
  "examples": [
    {
      "sourceText": "Ich soll früh aufstehen.",
      "targetText": "Trebuie să mă trezesc devreme."
    },
    {
      "sourceText": "Was soll ich tun?",
      "targetText": "Ce trebuie să fac?"
    },
    {
      "sourceText": "Du sollst nicht lügen.",
      "targetText": "Nu trebuie să minți."
    },
    {
      "sourceText": "Es sollte regnen.",
      "targetText": "Ar trebui să plouă."
    }
  ],
  "learningTips": [
    {
      "lang": "de",
      "text": "„trebuie“ bleibt fast immer unverändert: „trebuie să merg / să mergi / să meargă“."
    },
    {
      "lang": "de",
      "text": "„ar trebui“ ist der Konditional: „man sollte“."
    }
