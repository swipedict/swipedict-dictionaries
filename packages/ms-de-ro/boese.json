  "examples": [
    {
      "sourceText": "Ein böser Mensch.",
      "targetText": "Un om rău."
    },
    {
      "sourceText": "Bist du böse auf mich?",
      "targetText": "Ești supărat pe mine?"
    },
    {
      "sourceText": "Der böse Wolf.",
      "targetText": "Lupul cel rău."
    },
    {
      "sourceText": "Mir ist schlecht.",
      "targetText": "Îmi este rău."
    }
  ],
  "learningTips": [
    {
      "lang": "de",
      "text": "Für „böse sein auf jemanden“ sagt man „supărat pe cineva“, nicht „rău“."
    },
    {
      "lang": "de",
      "text": "„Îmi este rău“ heißt „Mir ist schlecht“ – wichtig beim Arzt."
    }
