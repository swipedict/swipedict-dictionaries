  "source": {
    "lang": "de",
    "headword": "böse",
    "definition": "Moralisch schlecht; auch: verärgert.",
    "pronunciation": "/ˈbøːzə/",
    "etymology": {
      "explanation": {
        "sourceText": "„Böse“ geht auf althochdeutsch „bōsi“ („wertlos, gering“) zurück.",
        "targetText": "„Böse” provine din germana veche înaltă „bōsi” („fără valoare, mărunt”)."
      },
      "source": "Etymological Dictionaries, Linguistic Analysis"
    }
  },
  "target": {
    "lang": "ro",
    "headword": "rău",
    "definition": "Moral rău; de asemenea: supărat.",
    "pronunciation": "/rəw/",
    "etymology": {
      "explanation": {
        "sourceText": "Das rumänische „rău“ stammt vom lateinischen „reus“ („angeklagt, schuldig“) – aus „schuldig“ wurde „schlecht, böse“.",
        "targetText": "Românescul „rău” provine din latinescul „reus” („acuzat, vinovat”); din „vinovat” a rezultat „rău”."
      },
      "source": "Etymological Dictionaries, Linguistic Analysis"
    }
  },
