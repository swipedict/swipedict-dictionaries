  "source": {
    "lang": "de",
    "headword": "ziemlich",
    "definition": "In merklichem, aber nicht höchstem Maße.",
    "pronunciation": "/ˈt͡siːmlɪç/",
    "etymology": {
      "explanation": {
        "sourceText": "„Ziemlich“ gehört zu „ziemen“ („sich gehören“) – ursprünglich „angemessen“.",
        "targetText": "„Ziemlich” este înrudit cu „ziemen” („a se cuveni”) – inițial „potrivit”."
      },
      "source": "Etymological Dictionaries, Linguistic Analysis"
    }
  },
  "target": {
    "lang": "ro",
    "headword": "destul de",
    "definition": "Într-o măsură apreciabilă, dar nu maximă.",
    "pronunciation": "/desˈtul de/",
    "etymology": {
      "explanation": {
        "sourceText": "Die rumänische Fügung enthält „destul“, das aus „de“ und „satul“ (< lateinisch „satullus“, gesättigt) entstand.",
        "targetText": "Construcția conține „destul”, format din „de” și „satul” (din latinescul „satullus”, sătul)."
      },
      "source": "Etymological Dictionaries, Linguistic Analysis"
    }
  },
