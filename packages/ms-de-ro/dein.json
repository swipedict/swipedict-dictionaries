  "source": {
    "lang": "de",
    "headword": "dein",
    "definition": "Possessivbegleiter der zweiten Person Singular: gehört dir.",
    "pronunciation": "/daɪ̯n/",
    "etymology": {
      "explanation": {
        "sourceText": "„Dein“ geht auf althochdeutsch „dīn“ zurück, gebildet zum Personalpronomen „du“.",
        "targetText": "„Dein” provine din germana veche înaltă „dīn”, format de la pronumele „du”."
      },
      "source": "Etymological Dictionaries, Linguistic Analysis"
    }
  },
  "target": {
    "lang": "ro",
    "headword": "al tău",
    "definition": "Pronume posesiv de persoana a doua singular: care îți aparține.",
    "pronunciation": "/al təw/",
    "etymology": {
      "explanation": {
        "sourceText": "Das rumänische „al tău“ verbindet den Possessivartikel „al“ mit „tău“, das auf lateinisch „tuus“ zurückgeht.",
        "targetText": "Românescul „al tău” combină articolul posesiv „al” cu „tău”, din latinescul „tuus”."
      },
      "source": "Etymological Dictionaries, Linguistic Analysis"
    }
  },
