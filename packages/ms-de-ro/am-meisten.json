    "headword": "am meisten",
    "definition": "In höchstem Maße; Superlativ zu „viel“.",
    "pronunciation": "/am ˈmaɪ̯stn̩/",
    "etymology": {
      "explanation": {
        "sourceText": "„Am meisten“ ist der Superlativ zu „viel“, gebildet mit „meist“ (althochdeutsch „meist“).",
        "targetText": "„Am meisten” este superlativul lui „viel”, format cu „meist” (germana veche înaltă „meist”)."
      },
      "source": "Etymological Dictionaries, Linguistic Analysis"
    }
  },
  "target": {
    "lang": "ro",
    "headword": "cel mai mult",
    "definition": "În cea mai mare măsură; superlativul lui „mult”.",
    "pronunciation": "/t͡ʃel maj mult/",
    "etymology": {
      "explanation": {
        "sourceText": "Der rumänische Superlativ entsteht aus dem Artikel „cel“ (< lateinisch „ecce illum“) und dem Komparativ „mai mult“.",
        "targetText": "Superlativul românesc se formează din articolul „cel” (din latinescul „ecce illum”) și comparativul „mai mult”."
      },
      "source": "Etymological Dictionaries, Linguistic Analysis"
    }
  },
