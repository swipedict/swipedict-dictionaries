  "source": {
    "lang": "de",
    "headword": "hoch",
    "definition": "Von großer Ausdehnung nach oben.",
    "pronunciation": "/hoːx/",
    "etymology": {
      "explanation": {
        "sourceText": "„Hoch“ geht auf althochdeutsch „hōh“ zurück, ein gemeingermanisches Wort.",
        "targetText": "„Hoch” provine din germana veche înaltă „hōh”, cuvânt comun germanic."
      },
      "source": "Etymological Dictionaries, Linguistic Analysis"
    }
  },
  "target": {
    "lang": "ro",
    "headword": "înalt",
    "definition": "Care are o mare întindere în sus.",
    "pronunciation": "/ɨˈnalt/",
    "etymology": {
      "explanation": {
        "sourceText": "Das rumänische „înalt“ geht auf lateinisch „in altus“ zurück – „in die Höhe“.",
        "targetText": "Românescul „înalt” provine din latinescul „in altus” – „în sus, în înălțime”."
      },
      "source": "Etymological Dictionaries, Linguistic Analysis"
    }
  },
