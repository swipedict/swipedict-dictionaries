  "source": {
    "lang": "de",
    "headword": "sofort",
    "definition": "Ohne jede Verzögerung, im selben Augenblick.",
    "pronunciation": "/zoˈfɔʁt/",
    "etymology": {
      "explanation": {
        "sourceText": "„Sofort“ ist aus „so“ und „fort“ zusammengesetzt – „gleich weiter, ohne Pause“.",
        "targetText": "„Sofort” este compus din „so” și „fort” – „îndată mai departe, fără pauză”."
      },
      "source": "Etymological Dictionaries, Linguistic Analysis"
    }
  },
  "target": {
    "lang": "ro",
    "headword": "imediat",
    "definition": "Fără nicio întârziere, în aceeași clipă.",
    "pronunciation": "/i.me.diˈat/",
    "etymology": {
      "explanation": {
        "sourceText": "Das rumänische „imediat“ ist aus dem Französischen „immédiat“ entlehnt; die lateinische Wurzel „immediatus“ heißt „ohne etwas dazwischen“.",
        "targetText": "Românescul „imediat” este împrumutat din franceză, din „immédiat”; rădăcina latină „immediatus” înseamnă „fără nimic la mijloc”."
      },
      "source": "Etymological Dictionaries, Linguistic Analysis"
    }
  },
