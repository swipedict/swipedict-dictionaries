  "source": {
    "lang": "de",
    "headword": "Kaffee",
    "definition": "Heißes Getränk aus gerösteten Kaffeebohnen.",
    "pronunciation": "/ˈkafeː/",
    "etymology": {
      "explanation": {
        "sourceText": "„Kaffee“ kam über französisch „café“ und italienisch „caffè“ aus türkisch „kahve“, letztlich aus arabisch „qahwa“.",
        "targetText": "„Kaffee” a ajuns prin franceză („café”) și italiană („caffè”) din turcescul „kahve”, la origine arabul „qahwa”."
      },
      "source": "Etymological Dictionaries, Linguistic Analysis"
    },
    "genus": "masculine"
  },
  "target": {
    "lang": "ro",
    "headword": "cafea",
    "definition": "Băutură fierbinte din boabe de cafea prăjite.",
    "pronunciation": "/kaˈfea/",
    "etymology": {
      "explanation": {
        "sourceText": "Das rumänische „cafea“ wurde direkt aus dem Türkischen „kahve“ übernommen – nicht über das Französische wie im Deutschen.",
        "targetText": "Românescul „cafea” a fost preluat direct din turcescul „kahve” – nu prin franceză, ca în germană."
      },
      "source": "Etymological Dictionaries, Linguistic Analysis"
    },
    "genus": "feminine"
  },
