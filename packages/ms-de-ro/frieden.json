    "headword": "Frieden",
    "definition": "Zustand ohne Krieg oder Streit.",
    "pronunciation": "/ˈfʁiːdn̩/",
    "etymology": {
      "explanation": {
        "sourceText": "„Frieden“ geht auf althochdeutsch „fridu“ zurück, verwandt mit „frei“ und „Freund“.",
        "targetText": "„Frieden” provine din germana veche înaltă „fridu”, înrudit cu „frei” și „Freund”."
      },
      "source": "Etymological Dictionaries, Linguistic Analysis"
    },
    "genus": "masculine"
  },
  "target": {
    "lang": "ro",
    "headword": "pace",
    "definition": "Stare fără război sau conflict.",
    "pronunciation": "/ˈpa.t͡ʃe/",
    "etymology": {
      "explanation": {
        "sourceText": "Das rumänische „pace“ stammt vom lateinischen „pax, pacem“ – dieselbe Wurzel wie in „Pakt“ und „pazifistisch“.",
        "targetText": "Românescul „pace” provine din latinescul „pax, pacem” – aceeași rădăcină ca în „pact” și „pacifist”."
      },
      "source": "Etymological Dictionaries, Linguistic Analysis"
    },
    "genus": "feminine"
  },
