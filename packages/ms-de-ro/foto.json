  "source": {
    "lang": "de",
    "headword": "Foto",
    "definition": "Mit einer Kamera aufgenommenes Bild.",
    "pronunciation": "/ˈfoːto/",
    "etymology": {
      "explanation": {
        "sourceText": "„Foto“ ist die Kurzform von „Fotografie“, gebildet aus griechisch „phōs“ (Licht) und „gráphein“ (schreiben).",
        "targetText": "„Foto” este forma scurtă a lui „Fotografie”, din grecescul „phōs” (lumină) și „gráphein” (a scrie)."
      },
      "source": "Etymological Dictionaries, Linguistic Analysis"
    },
    "genus": "neuter"
  },
  "target": {
    "lang": "ro",
    "headword": "fotografie",
    "definition": "Imagine realizată cu un aparat de fotografiat.",
    "pronunciation": "/fo.to.ɡraˈfi.e/",
    "etymology": {
      "explanation": {
        "sourceText": "Das rumänische „fotografie“ ist aus dem Französischen „photographie“ entlehnt; die Bestandteile sind griechisch: „Lichtschrift“.",
        "targetText": "Românescul „fotografie” este împrumutat din franceză, din „photographie”; elementele sunt grecești: „scriere cu lumină”."
      },
      "source": "Etymological Dictionaries, Linguistic Analysis"
    },
    "genus": "feminine"
  },
