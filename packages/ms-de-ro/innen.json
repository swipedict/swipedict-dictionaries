  "source": {
    "lang": "de",
    "headword": "innen",
    "definition": "Im Inneren von etwas.",
    "pronunciation": "/ˈɪnən/",
    "etymology": {
      "explanation": {
        "sourceText": "„Innen“ geht auf althochdeutsch „innana“ zurück, zur Präposition „in“.",
        "targetText": "„Innen” provine din germana veche înaltă „innana”, de la prepoziția „in”."
      },
      "source": "Etymological Dictionaries, Linguistic Analysis"
    }
  },
  "target": {
    "lang": "ro",
    "headword": "înăuntru",
    "definition": "În interiorul a ceva.",
    "pronunciation": "/ɨ.nəˈun.tru/",
    "etymology": {
      "explanation": {
        "sourceText": "Das rumänische „înăuntru“ geht auf lateinisch „in ad intro“ zurück – eine dreifach verstärkte Form von „intro“ („hinein“).",
        "targetText": "Românescul „înăuntru” provine din latinescul „in ad intro” – o formă întreit întărită a lui „intro” („înăuntru”)."
      },
      "source": "Etymological Dictionaries, Linguistic Analysis"
    }
  },
