  "source": {
    "lang": "de",
    "headword": "tief",
    "definition": "Von großer Ausdehnung nach unten oder nach innen.",
    "pronunciation": "/tiːf/",
    "etymology": {
      "explanation": {
        "sourceText": "„Tief“ geht auf althochdeutsch „tiof“ zurück, verwandt mit englisch „deep“.",
        "targetText": "„Tief” provine din germana veche înaltă „tiof”, înrudit cu englezescul „deep”."
      },
      "source": "Etymological Dictionaries, Linguistic Analysis"
    }
  },
  "target": {
    "lang": "ro",
    "headword": "adânc",
    "definition": "Care are o mare întindere în jos sau spre interior.",
    "pronunciation": "/aˈdɨŋk/",
    "etymology": {
      "explanation": {
        "sourceText": "Das rumänische „adânc“ geht auf lateinisch „aduncus“ („gekrümmt, eingebogen“) zurück.",
        "targetText": "Românescul „adânc” provine din latinescul „aduncus” („încovoiat, adâncit”)."
      },
      "source": "Etymological Dictionaries, Linguistic Analysis"
    }
  },
