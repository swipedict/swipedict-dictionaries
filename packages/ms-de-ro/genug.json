  "source": {
    "lang": "de",
    "headword": "genug",
    "definition": "So viel wie nötig; ausreichend.",
    "pronunciation": "/ɡəˈnuːk/",
    "etymology": {
      "explanation": {
        "sourceText": "„Genug“ geht auf althochdeutsch „ginuog“ zurück, zum Verb „genügen“.",
        "targetText": "„Genug” provine din germana veche înaltă „ginuog”, de la verbul „genügen”."
      },
      "source": "Etymological Dictionaries, Linguistic Analysis"
    }
  },
  "target": {
    "lang": "ro",
    "headword": "destul",
    "definition": "Atât cât este nevoie; suficient.",
    "pronunciation": "/desˈtul/",
    "etymology": {
      "explanation": {
        "sourceText": "Das rumänische „destul“ entstand aus „de“ und „satul“ (< lateinisch „satullus“, gesättigt) – wörtlich „bis zur Sättigung“.",
        "targetText": "Românescul „destul” s-a format din „de” și „satul” (din latinescul „satullus”) – literal „până la săturare”."
      },
      "source": "Etymological Dictionaries, Linguistic Analysis"
    }
  },
