  "source": {
    "lang": "de",
    "headword": "Berg",
    "definition": "Große natürliche Erhebung des Geländes.",
    "pronunciation": "/bɛʁk/",
    "etymology": {
      "explanation": {
        "sourceText": "„Berg“ geht auf althochdeutsch „berg“ zurück, aus einer germanischen Wurzel mit der Bedeutung „hoch“.",
        "targetText": "„Berg” provine din germana veche înaltă „berg”, dintr-o rădăcină germanică însemnând „înalt”."
      },
      "source": "Etymological Dictionaries, Linguistic Analysis"
    },
    "genus": "masculine"
  },
  "target": {
    "lang": "ro",
    "headword": "munte",
    "definition": "Ridicătură naturală mare a terenului.",
    "pronunciation": "/ˈmun.te/",
    "etymology": {
      "explanation": {
        "sourceText": "Das rumänische „munte“ stammt vom lateinischen „mons, montis“ – dieselbe Wurzel steckt in „Montenegro“ und „montan“.",
        "targetText": "Românescul „munte” provine din latinescul „mons, montis” – aceeași rădăcină se regăsește în „Muntenegru” și „montan”."
      },
      "source": "Etymological Dictionaries, Linguistic Analysis"
    },
    "genus": "masculine"
  },
