  "learningTips": [
    {
      "lang": "de",
      "text": "„la munte“ heißt „in die Berge“ – Rumänisch benutzt den Singular, wo Deutsch den Plural nimmt."
    },
    {
      "lang": "de",
      "text": "Plural: „munți“. Merke „montan“ als Eselsbrücke zur lateinischen Wurzel."
    }
