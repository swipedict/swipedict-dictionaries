  "examples": [
    {
      "sourceText": "Der Berg ist hoch.",
      "targetText": "Muntele este înalt."
    },
    {
      "sourceText": "Wir fahren in die Berge.",
      "targetText": "Mergem la munte."
    },
    {
      "sourceText": "Auf dem Berg liegt Schnee.",
      "targetText": "Pe munte este zăpadă."
    },
    {
      "sourceText": "Die Karpaten sind schöne Berge.",
      "targetText": "Carpații sunt munți frumoși."
    }
