  "source": {
    "lang": "de",
    "headword": "überall",
    "definition": "An allen Orten, ohne Ausnahme.",
    "pronunciation": "/yːbɐˈʔal/",
    "etymology": {
      "explanation": {
        "sourceText": "„Überall“ ist aus „über“ und „all“ zusammengesetzt – „über alles hin“.",
        "targetText": "„Überall” este compus din „über” și „all” – „peste tot”."
      },
      "source": "Etymological Dictionaries, Linguistic Analysis"
    }
  },
  "target": {
    "lang": "ro",
    "headword": "pretutindeni",
    "definition": "În toate locurile, fără excepție.",
    "pronunciation": "/pre.tu.tinˈdenʲ/",
    "etymology": {
      "explanation": {
        "sourceText": "Das rumänische „pretutindeni“ geht auf lateinisch „per totum inde“ zurück – „durch das Ganze hindurch“.",
        "targetText": "Românescul „pretutindeni” provine din latinescul „per totum inde” – „prin tot locul”."
      },
      "source": "Etymological Dictionaries, Linguistic Analysis"
    }
  },
