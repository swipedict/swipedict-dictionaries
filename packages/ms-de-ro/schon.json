  "source": {
    "lang": "de",
    "headword": "schon",
    "definition": "Früher als erwartet; zu diesem Zeitpunkt bereits.",
    "pronunciation": "/ʃoːn/",
    "etymology": {
      "explanation": {
        "sourceText": "„Schon“ geht auf althochdeutsch „scōno“ („schön, sorgfältig“) zurück; die zeitliche Bedeutung entwickelte sich erst später.",
        "targetText": "„Schon” provine din germana veche înaltă „scōno” („frumos, cu grijă”); sensul temporal s-a dezvoltat mai târziu."
      },
      "source": "Etymological Dictionaries, Linguistic Analysis"
    }
  },
  "target": {
    "lang": "ro",
    "headword": "deja",
    "definition": "Mai devreme decât se aștepta; până în acest moment.",
    "pronunciation": "/deˈʒa/",
    "etymology": {
      "explanation": {
        "sourceText": "Das rumänische „deja“ ist aus dem Französischen „déjà“ entlehnt, das seinerseits aus „dès“ und „ja“ („schon jetzt“) entstand.",
        "targetText": "Românescul „deja” este împrumutat din franceză, din „déjà”, format la rândul lui din „dès” și „ja”."
      },
      "source": "Etymological Dictionaries, Linguistic Analysis"
    }
  },
