  ],
  "examples": [
    {
      "sourceText": "Ich habe schon gegessen.",
      "targetText": "Am mâncat deja."
    },
    {
      "sourceText": "Bist du schon da?",
      "targetText": "Ai ajuns deja?"
    },
    {
      "sourceText": "Es ist schon spät.",
      "targetText": "Este deja târziu."
    },
    {
      "sourceText": "Sie weiß es schon.",
      "targetText": "Ea știe deja."
    }
  ],
  "learningTips": [
    {
      "lang": "de",
      "text": "„deja“ steht meist nach dem Verb: „am mâncat deja“."
    },
    {
      "lang": "de",
      "text": "Verneint wird daraus „încă nu“ = „noch nicht“."
    }
