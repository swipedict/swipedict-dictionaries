  "source": {
    "lang": "de",
    "headword": "Teil",
    "definition": "Ein Stück oder Abschnitt eines Ganzen.",
    "pronunciation": "/taɪ̯l/",
    "etymology": {
      "explanation": {
        "sourceText": "„Teil“ geht auf althochdeutsch „teil“ zurück, ein gemeingermanisches Wort.",
        "targetText": "„Teil” provine din germana veche înaltă „teil”, cuvânt comun germanic."
      },
      "source": "Etymological Dictionaries, Linguistic Analysis"
    },
    "genus": "neuter"
  },
  "target": {
    "lang": "ro",
    "headword": "parte",
    "definition": "O bucată sau o secțiune dintr-un întreg.",
    "pronunciation": "/ˈpar.te/",
    "etymology": {
      "explanation": {
        "sourceText": "Das rumänische „parte“ stammt vom lateinischen „pars, partem“ – dieselbe Wurzel wie in „Partei“ und „Partitur“.",
        "targetText": "Românescul „parte” provine din latinescul „pars, partem” – aceeași rădăcină ca în „partid” și „partitură”."
      },
      "source": "Etymological Dictionaries, Linguistic Analysis"
    },
    "genus": "feminine"
  },
