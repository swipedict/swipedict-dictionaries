  "source": {
    "lang": "de",
    "headword": "geschlossen",
    "definition": "Nicht offen; nicht zugänglich.",
    "pronunciation": "/ɡəˈʃlɔsn̩/",
    "etymology": {
      "explanation": {
        "sourceText": "„Geschlossen“ ist das Partizip von „schließen“, althochdeutsch „sliozan“.",
        "targetText": "„Geschlossen” este participiul verbului „schließen”, în germana veche înaltă „sliozan”."
      },
      "source": "Etymological Dictionaries, Linguistic Analysis"
    }
  },
  "target": {
    "lang": "ro",
    "headword": "închis",
    "definition": "Care nu este deschis; inaccesibil.",
    "pronunciation": "/ɨnˈkis/",
    "etymology": {
      "explanation": {
        "sourceText": "Das rumänische „închis“ ist das Partizip von „a închide“, das auf lateinisch „includere“ („einschließen“) zurückgeht.",
        "targetText": "Românescul „închis” este participiul verbului „a închide”, din latinescul „includere” („a închide în”)."
      },
      "source": "Etymological Dictionaries, Linguistic Analysis"
    }
  },
