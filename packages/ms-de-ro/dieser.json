  "source": {
    "lang": "de",
    "headword": "dieser",
    "definition": "Hinweisendes Wort für etwas Nahes.",
    "pronunciation": "/ˈdiːzɐ/",
    "etymology": {
      "explanation": {
        "sourceText": "„Dieser“ entstand aus althochdeutsch „dese“, einer Verstärkung des einfachen Demonstrativs „der“.",
        "targetText": "„Dieser” provine din germana veche înaltă „dese”, o întărire a demonstrativului simplu „der”."
      },
      "source": "Etymological Dictionaries, Linguistic Analysis"
    }
  },
  "target": {
    "lang": "ro",
    "headword": "acesta",
    "definition": "Cuvânt demonstrativ pentru ceva apropiat.",
    "pronunciation": "/aˈt͡ʃes.ta/",
    "etymology": {
      "explanation": {
        "sourceText": "Das rumänische „acesta“ setzt sich aus lateinisch „eccum“ („siehe da“) und „iste“ („dieser“) zusammen.",
        "targetText": "Românescul „acesta” este format din latinescul „eccum” („iată”) și „iste” („acesta”)."
      },
      "source": "Etymological Dictionaries, Linguistic Analysis"
    }
  },
