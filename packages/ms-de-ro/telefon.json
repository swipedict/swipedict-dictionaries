  "source": {
    "lang": "de",
    "headword": "Telefon",
    "definition": "Gerät, mit dem man über Entfernung sprechen kann.",
    "pronunciation": "/teleˈfoːn/",
    "etymology": {
      "explanation": {
        "sourceText": "„Telefon“ ist eine Neubildung des 19. Jahrhunderts aus griechisch „tēle“ (fern) und „phōnḗ“ (Stimme).",
        "targetText": "„Telefon” este o creație din secolul al XIX-lea, din grecescul „tēle” (departe) și „phōnḗ” (voce)."
      },
      "source": "Etymological Dictionaries, Linguistic Analysis"
    },
    "genus": "neuter"
  },
  "target": {
    "lang": "ro",
    "headword": "telefon",
    "definition": "Aparat cu care se poate vorbi la distanță.",
    "pronunciation": "/te.leˈfon/",
    "etymology": {
      "explanation": {
        "sourceText": "Das rumänische „telefon“ ist aus dem Französischen „téléphone“ entlehnt; die Bestandteile sind griechisch: „Fernstimme“.",
        "targetText": "Românescul „telefon” este împrumutat din franceză, din „téléphone”; elementele sunt grecești: „voce de la distanță”."
      },
      "source": "Etymological Dictionaries, Linguistic Analysis"
    },
    "genus": "neuter"
  },
