  "source": {
    "lang": "de",
    "headword": "Farbe",
    "definition": "Eigenschaft wie Rot, Blau oder Grün, die das Auge wahrnimmt.",
    "pronunciation": "/ˈfaʁbə/",
    "etymology": {
      "explanation": {
        "sourceText": "„Farbe“ geht auf althochdeutsch „farawa“ zurück, ein gemeingermanisches Wort.",
        "targetText": "„Farbe” provine din germana veche înaltă „farawa”, cuvânt comun germanic."
      },
      "source": "Etymological Dictionaries, Linguistic Analysis"
    },
    "genus": "feminine"
  },
  "target": {
    "lang": "ro",
    "headword": "culoare",
    "definition": "Însușire ca roșu, albastru sau verde, percepută de ochi.",
    "pronunciation": "/kuˈloa.re/",
    "etymology": {
      "explanation": {
        "sourceText": "Das rumänische „culoare“ stammt vom lateinischen „color, coloris“ – dieselbe Wurzel wie in „kolorieren“.",
        "targetText": "Românescul „culoare” provine din latinescul „color, coloris” – aceeași rădăcină ca în „a colora”."
      },
      "source": "Etymological Dictionaries, Linguistic Analysis"
    },
    "genus": "feminine"
  },
