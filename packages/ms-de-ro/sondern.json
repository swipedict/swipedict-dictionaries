  "source": {
    "lang": "de",
    "headword": "sondern",
    "definition": "Konjunktion, die nach einer Verneinung die richtige Alternative nennt.",
    "pronunciation": "/ˈzɔndɐn/",
    "etymology": {
      "explanation": {
        "sourceText": "„Sondern“ gehört zu „sonder“ („getrennt, besonders“), althochdeutsch „suntar“.",
        "targetText": "„Sondern” este înrudit cu „sonder” („separat, aparte”), în germana veche înaltă „suntar”."
      },
      "source": "Etymological Dictionaries, Linguistic Analysis"
    }
  },
  "target": {
    "lang": "ro",
    "headword": "ci",
    "definition": "Conjuncție care, după o negație, introduce alternativa corectă.",
    "pronunciation": "/t͡ʃi/",
    "etymology": {
      "explanation": {
        "sourceText": "Das rumänische „ci“ geht auf lateinisch „quid“ zurück und übernahm die Rolle einer adversativen Konjunktion.",
        "targetText": "Românescul „ci” provine din latinescul „quid” și a preluat rolul de conjuncție adversativă."
      },
      "source": "Etymological Dictionaries, Linguistic Analysis"
    }
  },
  "senses": [],
