  ],
  "examples": [
    {
      "sourceText": "Nicht heute, sondern morgen.",
      "targetText": "Nu astăzi, ci mâine."
    },
    {
      "sourceText": "Er ist nicht müde, sondern krank.",
      "targetText": "Nu este obosit, ci bolnav."
    },
    {
      "sourceText": "Nicht ich, sondern du.",
      "targetText": "Nu eu, ci tu."
    },
    {
      "sourceText": "Nicht teuer, sondern billig.",
      "targetText": "Nu scump, ci ieftin."
    }
  ],
  "learningTips": [
    {
      "lang": "de",
      "text": "„ci“ steht nur nach einer Verneinung – genau wie deutsch „sondern“."
    },
    {
      "lang": "de",
      "text": "Ohne Verneinung nimmt man „dar“: „mic, dar frumos“."
    }
  ],
