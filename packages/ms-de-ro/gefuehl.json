    "headword": "Gefühl",
    "definition": "Innere Empfindung wie Freude, Angst oder Liebe.",
    "pronunciation": "/ɡəˈfyːl/",
    "etymology": {
      "explanation": {
        "sourceText": "„Gefühl“ ist von „fühlen“ abgeleitet, althochdeutsch „fuolen“.",
        "targetText": "„Gefühl” este derivat de la „fühlen”, în germana veche înaltă „fuolen”."
      },
      "source": "Etymological Dictionaries, Linguistic Analysis"
    },
    "genus": "neuter"
  },
  "target": {
    "lang": "ro",
    "headword": "sentiment",
    "definition": "Trăire interioară precum bucuria, teama sau iubirea.",
    "pronunciation": "/sen.tiˈment/",
    "etymology": {
      "explanation": {
        "sourceText": "Das rumänische „sentiment“ ist aus dem Französischen „sentiment“ entlehnt; die lateinische Wurzel „sentire“ heißt „fühlen“.",
        "targetText": "Românescul „sentiment” este împrumutat din franceză, din „sentiment”; rădăcina latină „sentire” înseamnă „a simți”."
      },
      "source": "Etymological Dictionaries, Linguistic Analysis"
