    "headword": "Suppe",
    "definition": "Flüssige warme Speise, meist als Vorspeise.",
    "pronunciation": "/ˈzʊpə/",
    "etymology": {
      "explanation": {
        "sourceText": "„Suppe“ kam aus dem Französischen „soupe“ ins Deutsche; die Wurzel ist das germanische „sup-“ (schlürfen).",
        "targetText": "„Suppe” a intrat în germană din franceză („soupe”); rădăcina este germanicul „sup-” („a sorbi”)."
      },
      "source": "Etymological Dictionaries, Linguistic Analysis"
    },
    "genus": "feminine"
  },
  "target": {
    "lang": "ro",
    "headword": "supă",
    "definition": "Preparat lichid și cald, servit de obicei ca fel întâi.",
    "pronunciation": "/ˈsu.pə/",
    "etymology": {
      "explanation": {
        "sourceText": "Das rumänische „supă“ ist aus dem Französischen „soupe“ entlehnt – ein Küchenwort aus dem 19. Jahrhundert.",
        "targetText": "Românescul „supă” este împrumutat din franceză, din „soupe” – un termen culinar din secolul al XIX-lea."
      },
      "source": "Etymological Dictionaries, Linguistic Analysis"
    },
    "genus": "feminine"
  },
