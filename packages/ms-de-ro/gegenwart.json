  "examples": [
    {
      "sourceText": "In der Gegenwart.",
      "targetText": "În prezent."
    },
    {
      "sourceText": "Vergangenheit und Gegenwart.",
      "targetText": "Trecutul și prezentul."
    },
    {
      "sourceText": "Er ist anwesend.",
