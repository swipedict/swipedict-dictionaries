  "source": {
    "lang": "de",
    "headword": "Gegenwart",
    "definition": "Die Zeit, die jetzt ist; auch: Anwesenheit.",
    "pronunciation": "/ˈɡeːɡn̩vaʁt/",
    "etymology": {
      "explanation": {
        "sourceText": "„Gegenwart“ ist aus „gegen“ und „-wart“ (zugewandt) zusammengesetzt – wörtlich „das Zugewandte“.",
        "targetText": "„Gegenwart” este compus din „gegen” și „-wart” („întors spre”) – literal „ceea ce este de față”."
      },
      "source": "Etymological Dictionaries, Linguistic Analysis"
    },
    "genus": "feminine"
  },
  "target": {
    "lang": "ro",
    "headword": "prezent",
    "definition": "Timpul de acum; de asemenea: faptul de a fi de față.",
    "pronunciation": "/preˈzent/",
    "etymology": {
      "explanation": {
        "sourceText": "Das rumänische „prezent“ ist aus dem Französischen „présent“ entlehnt; die lateinische Wurzel „praesens“ heißt „vorne seiend, anwesend“.",
        "targetText": "Românescul „prezent” este împrumutat din franceză, din „présent”; rădăcina latină „praesens” înseamnă „care este de față”."
      },
      "source": "Etymological Dictionaries, Linguistic Analysis"
    },
    "genus": "neuter"
  },
