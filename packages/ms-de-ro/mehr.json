  "source": {
    "lang": "de",
    "headword": "mehr",
    "definition": "Eine größere Menge oder ein höherer Grad.",
    "pronunciation": "/meːɐ̯/",
    "etymology": {
      "explanation": {
        "sourceText": "„Mehr“ ist der Komparativ zu „viel“, althochdeutsch „mēr“.",
        "targetText": "„Mehr” este comparativul lui „viel”, în germana veche înaltă „mēr”."
      },
      "source": "Etymological Dictionaries, Linguistic Analysis"
    }
  },
  "target": {
    "lang": "ro",
    "headword": "mai mult",
    "definition": "O cantitate mai mare sau un grad mai înalt.",
    "pronunciation": "/maj mult/",
    "etymology": {
      "explanation": {
        "sourceText": "Die Fügung verbindet die Komparativpartikel „mai“ (< lateinisch „magis“) mit „mult“ (< lateinisch „multus“).",
        "targetText": "Construcția leagă particula de comparativ „mai” (din latinescul „magis”) cu „mult” (din „multus”)."
      },
      "source": "Etymological Dictionaries, Linguistic Analysis"
    }
  },
