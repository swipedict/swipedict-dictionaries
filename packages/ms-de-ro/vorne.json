  "source": {
    "lang": "de",
    "headword": "vorne",
    "definition": "An der vorderen Seite, am Anfang von etwas.",
    "pronunciation": "/ˈfɔʁnə/",
    "etymology": {
      "explanation": {
        "sourceText": "„Vorne“ ist von der Präposition „vor“ abgeleitet, althochdeutsch „fora“.",
        "targetText": "„Vorne” este derivat de la prepoziția „vor”, în germana veche înaltă „fora”."
      },
      "source": "Etymological Dictionaries, Linguistic Analysis"
    }
  },
  "target": {
    "lang": "ro",
    "headword": "în față",
    "definition": "În partea din față, la începutul a ceva.",
    "pronunciation": "/ɨn ˈfa.t͡sə/",
    "etymology": {
      "explanation": {
        "sourceText": "Die rumänische Fügung „în față“ enthält „față“, das auf vulgärlateinisch „facia“ („Gesicht, Vorderseite“) zurückgeht.",
        "targetText": "Construcția „în față” conține „față”, din latinescul popular „facia” („chip, partea din față”)."
      },
      "source": "Etymological Dictionaries, Linguistic Analysis"
    }
  },
