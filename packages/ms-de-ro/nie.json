  "source": {
    "lang": "de",
    "headword": "nie",
    "definition": "Zu keiner Zeit.",
    "pronunciation": "/niː/",
    "etymology": {
      "explanation": {
        "sourceText": "„Nie“ entstand aus althochdeutsch „nio“, aus „ni“ (nicht) und „io“ (je).",
        "targetText": "„Nie” provine din germana veche înaltă „nio”, din „ni” (nu) și „io” (vreodată)."
      },
      "source": "Etymological Dictionaries, Linguistic Analysis"
    }
  },
  "target": {
    "lang": "ro",
    "headword": "niciodată",
    "definition": "În niciun moment.",
    "pronunciation": "/ni.t͡ʃi.oˈda.tə/",
    "etymology": {
      "explanation": {
        "sourceText": "Das rumänische „niciodată“ ist aus „nici“ (< lateinisch „neque“), „o“ und „dată“ (< lateinisch „data“) gebildet – „nicht ein einziges Mal“.",
        "targetText": "Românescul „niciodată” este format din „nici” (din latinescul „neque”), „o” și „dată” (din „data”) – „nici măcar o dată”."
      },
      "source": "Etymological Dictionaries, Linguistic Analysis"
    }
  },
