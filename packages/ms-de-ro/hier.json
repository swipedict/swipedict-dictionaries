  "source": {
    "lang": "de",
    "headword": "hier",
    "definition": "An diesem Ort, an der Stelle des Sprechers.",
    "pronunciation": "/hiːɐ̯/",
    "etymology": {
      "explanation": {
        "sourceText": "„Hier“ geht auf althochdeutsch „hiar“ zurück, gebildet zum Demonstrativstamm „hi-“.",
        "targetText": "„Hier” provine din germana veche înaltă „hiar”, format de la rădăcina demonstrativă „hi-”."
      },
      "source": "Etymological Dictionaries, Linguistic Analysis"
    }
  },
  "target": {
    "lang": "ro",
    "headword": "aici",
    "definition": "În acest loc, unde se află vorbitorul.",
    "pronunciation": "/aˈit͡ʃʲ/",
    "etymology": {
      "explanation": {
        "sourceText": "Das rumänische „aici“ geht auf lateinisch „ad hicce“ zurück, eine verstärkte Form von „hic“ („hier“).",
        "targetText": "Românescul „aici” provine din latinescul „ad hicce”, formă întărită a lui „hic” („aici”)."
      },
      "source": "Etymological Dictionaries, Linguistic Analysis"
    }
  },
