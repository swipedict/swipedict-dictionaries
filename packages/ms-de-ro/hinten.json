  "source": {
    "lang": "de",
    "headword": "hinten",
    "definition": "An der hinteren Seite, am Ende von etwas.",
    "pronunciation": "/ˈhɪntn̩/",
    "etymology": {
      "explanation": {
        "sourceText": "„Hinten“ ist von „hinter“ abgeleitet, althochdeutsch „hintana“.",
        "targetText": "„Hinten” este derivat de la „hinter”, în germana veche înaltă „hintana”."
      },
      "source": "Etymological Dictionaries, Linguistic Analysis"
    }
  },
  "target": {
    "lang": "ro",
    "headword": "în spate",
    "definition": "În partea din spate, la capătul a ceva.",
    "pronunciation": "/ɨn ˈspa.te/",
    "etymology": {
      "explanation": {
        "sourceText": "Die Fügung „în spate“ enthält „spate“, das auf lateinisch „spatha“ („Rücken, Schulterblatt“) zurückgeht.",
        "targetText": "Construcția „în spate” conține „spate”, din latinescul „spatha” („spate, omoplat”)."
      },
      "source": "Etymological Dictionaries, Linguistic Analysis"
    }
  },
