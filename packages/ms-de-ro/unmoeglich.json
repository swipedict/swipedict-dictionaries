  "source": {
    "lang": "de",
    "headword": "unmöglich",
    "definition": "Was nicht geschehen oder getan werden kann.",
    "pronunciation": "/ʊnˈmøːklɪç/",
    "etymology": {
      "explanation": {
        "sourceText": "„Unmöglich“ ist „möglich“ mit der verneinenden Vorsilbe „un-“.",
        "targetText": "„Unmöglich” este „möglich” cu prefixul negativ „un-”."
      },
      "source": "Etymological Dictionaries, Linguistic Analysis"
    }
  },
  "target": {
    "lang": "ro",
    "headword": "imposibil",
    "definition": "Care nu se poate întâmpla sau realiza.",
    "pronunciation": "/im.poˈsi.bil/",
    "etymology": {
      "explanation": {
        "sourceText": "Das rumänische „imposibil“ ist aus dem Französischen „impossible“ entlehnt; das lateinische Präfix „in-“ verneint „possibilis“.",
        "targetText": "Românescul „imposibil” este împrumutat din franceză, din „impossible”; prefixul latin „in-” neagă pe „possibilis”."
      },
      "source": "Etymological Dictionaries, Linguistic Analysis"
    }
  },
