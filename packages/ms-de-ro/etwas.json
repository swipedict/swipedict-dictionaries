  "examples": [
    {
      "sourceText": "Ich möchte etwas essen.",
      "targetText": "Vreau să mănânc ceva."
    },
    {
      "sourceText": "Sagst du mir etwas?",
      "targetText": "Îmi spui ceva?"
    },
    {
      "sourceText": "Da ist etwas passiert.",
      "targetText": "S-a întâmplat ceva."
    },
    {
      "sourceText": "Etwas Neues?",
