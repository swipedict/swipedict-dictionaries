  "learningTips": [
    {
      "lang": "de",
      "text": "Die Partikel „-va“ macht Fragewörter unbestimmt: ce → ceva, cine → cineva, unde → undeva."
    },
    {
      "lang": "de",
      "text": "Anders als deutsch „etwas“ steht „ceva“ nie als Mengenangabe – dafür nimmt man „puțin“."
    }
