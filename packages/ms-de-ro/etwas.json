  "source": {
    "lang": "de",
    "headword": "etwas",
    "definition": "Eine nicht näher bestimmte Sache.",
    "pronunciation": "/ˈɛtvas/",
    "etymology": {
      "explanation": {
        "sourceText": "„Etwas“ entstand aus althochdeutsch „eddeswaz“, wörtlich „irgendetwas“.",
        "targetText": "„Etwas” provine din germana veche înaltă „eddeswaz”, literal „ceva oarecare”."
      },
      "source": "Etymological Dictionaries, Linguistic Analysis"
    }
  },
  "target": {
    "lang": "ro",
    "headword": "ceva",
    "definition": "Un lucru nedeterminat.",
    "pronunciation": "/t͡ʃeˈva/",
    "etymology": {
      "explanation": {
        "sourceText": "Das rumänische „ceva“ ist aus „ce“ (< lateinisch „quid“) und der unbestimmten Partikel „-va“ gebildet.",
        "targetText": "Românescul „ceva” este format din „ce” (din latinescul „quid”) și particula nehotărâtă „-va”."
      },
      "source": "Etymological Dictionaries, Linguistic Analysis"
    }
  },
