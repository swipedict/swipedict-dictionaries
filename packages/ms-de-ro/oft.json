    "headword": "oft",
    "definition": "Viele Male, in kurzen Abständen.",
    "pronunciation": "/ɔft/",
    "etymology": {
      "explanation": {
        "sourceText": "„Oft“ geht auf althochdeutsch „ofto“ zurück, ein gemeingermanisches Wort.",
        "targetText": "„Oft” provine din germana veche înaltă „ofto”, cuvânt comun germanic."
      },
      "source": "Etymological Dictionaries, Linguistic Analysis"
    }
  },
  "target": {
    "lang": "ro",
    "headword": "des",
    "definition": "De multe ori, la intervale scurte.",
    "pronunciation": "/des/",
    "etymology": {
      "explanation": {
        "sourceText": "Das rumänische „des“ stammt vom lateinischen „densus“ („dicht“) – aus räumlicher Dichte wurde zeitliche Häufigkeit.",
        "targetText": "Românescul „des” provine din latinescul „densus” („dens”); din densitatea spațială a rezultat frecvența în timp."
      },
      "source": "Etymological Dictionaries, Linguistic Analysis"
    }
  },
