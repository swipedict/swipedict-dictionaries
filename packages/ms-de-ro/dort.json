  "source": {
    "lang": "de",
    "headword": "dort",
    "definition": "An jenem Ort, entfernt vom Sprecher.",
    "pronunciation": "/dɔʁt/",
    "etymology": {
      "explanation": {
        "sourceText": "„Dort“ geht auf althochdeutsch „dara“ zurück, zum Demonstrativstamm „da-“.",
        "targetText": "„Dort” provine din germana veche înaltă „dara”, de la rădăcina demonstrativă „da-”."
      },
      "source": "Etymological Dictionaries, Linguistic Analysis"
    }
  },
  "target": {
    "lang": "ro",
    "headword": "acolo",
    "definition": "În acel loc, departe de vorbitor.",
    "pronunciation": "/aˈko.lo/",
    "etymology": {
      "explanation": {
        "sourceText": "Das rumänische „acolo“ geht auf lateinisch „eccum illoc“ zurück – „siehe, dort“.",
        "targetText": "Românescul „acolo” provine din latinescul „eccum illoc” – „iată, acolo”."
      },
      "source": "Etymological Dictionaries, Linguistic Analysis"
    }
  },
