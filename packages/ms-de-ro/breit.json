  "source": {
    "lang": "de",
    "headword": "breit",
    "definition": "Von großer Ausdehnung von einer Seite zur anderen.",
    "pronunciation": "/bʁaɪ̯t/",
    "etymology": {
      "explanation": {
        "sourceText": "„Breit“ geht auf althochdeutsch „breit“ zurück, ein gemeingermanisches Wort.",
        "targetText": "„Breit” provine din germana veche înaltă „breit”, cuvânt comun germanic."
      },
      "source": "Etymological Dictionaries, Linguistic Analysis"
    }
  },
  "target": {
    "lang": "ro",
    "headword": "lat",
    "definition": "Care are o mare întindere dintr-o parte în alta.",
    "pronunciation": "/lat/",
    "etymology": {
      "explanation": {
        "sourceText": "Das rumänische „lat“ stammt vom lateinischen „latus“ („breit“) – nicht zu verwechseln mit „latus“ (Seite).",
        "targetText": "Românescul „lat” provine din latinescul „latus” („lat”) – a nu se confunda cu „latus” („latură”)."
      },
      "source": "Etymological Dictionaries, Linguistic Analysis"
    }
  },
