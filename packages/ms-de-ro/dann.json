  "source": {
    "lang": "de",
    "headword": "dann",
    "definition": "Danach, im Anschluss daran.",
    "pronunciation": "/dan/",
    "etymology": {
      "explanation": {
        "sourceText": "„Dann“ geht auf althochdeutsch „danne“ zurück und war ursprünglich dasselbe Wort wie „denn“.",
        "targetText": "„Dann” provine din germana veche înaltă „danne” și era inițial același cuvânt cu „denn”."
      },
      "source": "Etymological Dictionaries, Linguistic Analysis"
    }
  },
  "target": {
    "lang": "ro",
    "headword": "apoi",
    "definition": "După aceea, în continuare.",
    "pronunciation": "/aˈpoj/",
    "etymology": {
      "explanation": {
        "sourceText": "Das rumänische „apoi“ geht auf lateinisch „ad post“ zurück – „danach“.",
        "targetText": "Românescul „apoi” provine din latinescul „ad post” – „după aceea”."
      },
      "source": "Etymological Dictionaries, Linguistic Analysis"
    }
  },
