  "source": {
    "lang": "de",
    "headword": "Spiel",
    "definition": "Tätigkeit zum Vergnügen, oft mit Regeln.",
    "pronunciation": "/ʃpiːl/",
    "etymology": {
      "explanation": {
        "sourceText": "„Spiel“ geht auf althochdeutsch „spil“ zurück; die weitere Herkunft ist unklar.",
        "targetText": "„Spiel” provine din germana veche înaltă „spil”; originea mai veche este neclară."
      },
      "source": "Etymological Dictionaries, Linguistic Analysis"
    },
    "genus": "neuter"
  },
  "target": {
    "lang": "ro",
    "headword": "joc",
    "definition": "Activitate de plăcere, adesea cu reguli.",
    "pronunciation": "/ʒok/",
    "etymology": {
      "explanation": {
        "sourceText": "Das rumänische „joc“ stammt vom lateinischen „jocus“ („Scherz, Spaß“) – dieselbe Wurzel wie in „Jokus“ und „Joker“.",
        "targetText": "Românescul „joc” provine din latinescul „jocus” („glumă, distracție”) – aceeași rădăcină ca în „joker”."
      },
      "source": "Etymological Dictionaries, Linguistic Analysis"
    },
    "genus": "neuter"
  },
