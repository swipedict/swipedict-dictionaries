  "source": {
    "lang": "de",
    "headword": "Beispiel",
    "definition": "Einzelfall, der etwas Allgemeines veranschaulicht.",
    "pronunciation": "/ˈbaɪ̯ʃpiːl/",
    "etymology": {
      "explanation": {
        "sourceText": "„Beispiel“ ist aus „bei“ und „Spiel“ (im alten Sinn „Erzählung“) zusammengesetzt.",
        "targetText": "„Beispiel” este compus din „bei” și „Spiel” (în sensul vechi de „povestire”)."
      },
      "source": "Etymological Dictionaries, Linguistic Analysis"
    },
    "genus": "neuter"
  },
  "target": {
    "lang": "ro",
    "headword": "exemplu",
    "definition": "Caz particular care ilustrează ceva general.",
    "pronunciation": "/eɡˈzem.plu/",
    "etymology": {
      "explanation": {
        "sourceText": "Das rumänische „exemplu“ ist aus dem Französischen „exemple“ entlehnt; die lateinische Wurzel „exemplum“ heißt „Herausgenommenes“.",
        "targetText": "Românescul „exemplu” este împrumutat din franceză, din „exemple”; rădăcina latină „exemplum” înseamnă „ceva luat drept model”."
      },
      "source": "Etymological Dictionaries, Linguistic Analysis"
    },
    "genus": "neuter"
  },
