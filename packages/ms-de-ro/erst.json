  ],
  "examples": [
    {
      "sourceText": "Er kommt erst um fünf.",
      "targetText": "Vine abia la cinci."
    },
    {
      "sourceText": "Ich bin erst angekommen.",
      "targetText": "Abia am ajuns."
    },
    {
      "sourceText": "Erst jetzt verstehe ich.",
      "targetText": "Abia acum înțeleg."
    },
    {
      "sourceText": "Sie ist erst zehn Jahre alt.",
      "targetText": "Are abia zece ani."
    }
  ],
  "learningTips": [
    {
      "lang": "de",
      "text": "„abia“ deckt „erst“ und „kaum“ ab – der Kontext entscheidet."
    },
    {
      "lang": "de",
      "text": "Man schreibt auch „de-abia“; die Bedeutung bleibt gleich."
    }
