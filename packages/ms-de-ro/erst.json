  "source": {
    "lang": "de",
    "headword": "erst",
    "definition": "Nicht früher als; gerade eben erst.",
    "pronunciation": "/eːɐ̯st/",
    "etymology": {
      "explanation": {
        "sourceText": "„Erst“ ist der erstarrte Superlativ von „eher“, althochdeutsch „ērist“ („zuerst“).",
        "targetText": "„Erst” este superlativul încremenit al lui „eher”, în germana veche înaltă „ērist” („primul”)."
      },
      "source": "Etymological Dictionaries, Linguistic Analysis"
    }
  },
  "target": {
    "lang": "ro",
    "headword": "abia",
    "definition": "Nu mai devreme de; chiar în acest moment.",
    "pronunciation": "/aˈbi.a/",
    "etymology": {
      "explanation": {
        "sourceText": "Das rumänische „abia“ geht auf lateinisch „ad vix“ zurück – „mit Mühe, kaum“.",
        "targetText": "Românescul „abia” provine din latinescul „ad vix” – „cu greu, de-abia”."
      },
      "source": "Etymological Dictionaries, Linguistic Analysis"
    }
  },
  "senses": [],
