  "source": {
    "lang": "de",
    "headword": "zu viel",
    "definition": "Mehr als nötig oder erträglich.",
    "pronunciation": "/t͡suː ˈfiːl/",
    "etymology": {
      "explanation": {
        "sourceText": "Die Fügung besteht aus der Gradpartikel „zu“ (althochdeutsch „zuo“) und „viel“ (althochdeutsch „filu“).",
        "targetText": "Construcția este formată din particula „zu” (germana veche înaltă „zuo”) și „viel” („filu”)."
      },
      "source": "Etymological Dictionaries, Linguistic Analysis"
    }
  },
  "target": {
    "lang": "ro",
    "headword": "prea mult",
    "definition": "Mai mult decât este nevoie sau suportabil.",
    "pronunciation": "/prea mult/",
    "etymology": {
      "explanation": {
        "sourceText": "Die rumänische Fügung enthält „prea“, ein slawisches Lehnwort aus „prě-“ („über, allzu“), und „mult“ (< lateinisch „multus“).",
        "targetText": "Construcția conține „prea”, împrumut slav din „prě-” („peste, prea”), și „mult” (din latinescul „multus”)."
      },
      "source": "Etymological Dictionaries, Linguistic Analysis"
    }
  },
