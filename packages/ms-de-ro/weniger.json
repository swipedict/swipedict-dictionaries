  "source": {
    "lang": "de",
    "headword": "weniger",
    "definition": "Eine kleinere Menge oder ein geringerer Grad.",
    "pronunciation": "/ˈveːnɪɡɐ/",
    "etymology": {
      "explanation": {
        "sourceText": "„Weniger“ ist der Komparativ zu „wenig“, althochdeutsch „wēnag“.",
        "targetText": "„Weniger” este comparativul lui „wenig”, în germana veche înaltă „wēnag”."
      },
      "source": "Etymological Dictionaries, Linguistic Analysis"
    }
  },
  "target": {
    "lang": "ro",
    "headword": "mai puțin",
    "definition": "O cantitate mai mică sau un grad mai scăzut.",
    "pronunciation": "/maj puˈt͡sin/",
    "etymology": {
      "explanation": {
        "sourceText": "Die Fügung verbindet „mai“ (< lateinisch „magis“) mit „puțin“ (< lateinisch „putinnus“, klein).",
        "targetText": "Construcția leagă „mai” (din latinescul „magis”) cu „puțin” (din „putinnus”, mic)."
      },
      "source": "Etymological Dictionaries, Linguistic Analysis"
    }
  },
