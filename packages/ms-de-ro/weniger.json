  "learningTips": [
    {
      "lang": "de",
      "text": "Auch der Komparativ „kleiner/weniger“ braucht „mai“ – nie eine Endung."
    },
    {
      "lang": "de",
      "text": "„cel mai puțin“ ist der Superlativ: am wenigsten."
