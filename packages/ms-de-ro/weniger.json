  "examples": [
    {
      "sourceText": "Weniger Zucker, bitte.",
      "targetText": "Mai puțin zahăr, vă rog."
    },
    {
      "sourceText": "Er arbeitet weniger.",
      "targetText": "El muncește mai puțin."
    },
    {
      "sourceText": "Weniger ist mehr.",
      "targetText": "Mai puțin înseamnă mai mult."
    },
    {
      "sourceText": "Nicht weniger als zehn.",
      "targetText": "Nu mai puțin de zece."
    }
