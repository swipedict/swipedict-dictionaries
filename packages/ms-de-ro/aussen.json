  "learningTips": [
    {
      "lang": "de",
      "text": "„afară“ deckt „außen“ und „draußen“ ab – Rumänisch trennt das nicht."
    },
    {
      "lang": "de",
      "text": "„în afară de“ heißt „außer“: „în afară de tine“."
    }
