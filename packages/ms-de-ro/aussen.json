  "source": {
    "lang": "de",
    "headword": "außen",
    "definition": "Außerhalb von etwas, im Freien.",
    "pronunciation": "/ˈaʊ̯sn̩/",
    "etymology": {
      "explanation": {
        "sourceText": "„Außen“ geht auf althochdeutsch „ūzana“ zurück, zur Präposition „aus“.",
        "targetText": "„Außen” provine din germana veche înaltă „ūzana”, de la prepoziția „aus”."
      },
      "source": "Etymological Dictionaries, Linguistic Analysis"
    }
  },
  "target": {
    "lang": "ro",
    "headword": "afară",
    "definition": "În exteriorul a ceva, în aer liber.",
    "pronunciation": "/aˈfa.rə/",
    "etymology": {
      "explanation": {
        "sourceText": "Das rumänische „afară“ geht auf lateinisch „ad foras“ zurück – „vor die Tür“, von „foris“ (Tür).",
        "targetText": "Românescul „afară” provine din latinescul „ad foras” – „la ușă, în exterior”, de la „foris” (ușă)."
      },
      "source": "Etymological Dictionaries, Linguistic Analysis"
    }
  },
