  "source": {
    "lang": "de",
    "headword": "viele",
    "definition": "Eine große Anzahl von Personen oder Dingen.",
    "pronunciation": "/ˈfiːlə/",
    "etymology": {
      "explanation": {
        "sourceText": "„Viel“ geht auf althochdeutsch „filu“ zurück, urverwandt mit griechisch „polýs“.",
        "targetText": "„Viel” provine din germana veche înaltă „filu”, înrudit cu grecescul „polýs”."
      },
      "source": "Etymological Dictionaries, Linguistic Analysis"
    }
  },
  "target": {
    "lang": "ro",
    "headword": "mulți",
    "definition": "Un număr mare de persoane sau lucruri.",
    "pronunciation": "/mult͡sʲ/",
    "etymology": {
      "explanation": {
        "sourceText": "Das rumänische „mulți“ stammt vom lateinischen „multus“ („viel“) – dieselbe Wurzel wie in „multi-“.",
        "targetText": "Românescul „mulți” provine din latinescul „multus” („mult”) – aceeași rădăcină ca în „multi-”."
      },
      "source": "Etymological Dictionaries, Linguistic Analysis"
    }
  },
