  "source": {
    "lang": "de",
    "headword": "früher",
    "definition": "Zu einem Zeitpunkt vor jetzt oder vor einem anderen.",
    "pronunciation": "/ˈfʁyːɐ/",
    "etymology": {
      "explanation": {
        "sourceText": "„Früher“ ist der Komparativ von „früh“, althochdeutsch „fruoi“.",
        "targetText": "„Früher” este comparativul lui „früh”, în germana veche înaltă „fruoi”."
      },
      "source": "Etymological Dictionaries, Linguistic Analysis"
    }
  },
  "target": {
    "lang": "ro",
    "headword": "mai devreme",
    "definition": "La un moment dinaintea celui prezent sau al altuia.",
    "pronunciation": "/maj deˈvre.me/",
    "etymology": {
      "explanation": {
        "sourceText": "Die Fügung verbindet „mai“ (< lateinisch „magis“) mit „devreme“, das aus „de“ und „vreme“ (slawisch „vremę“, Zeit) besteht.",
        "targetText": "Construcția leagă „mai” (din latinescul „magis”) cu „devreme”, format din „de” și „vreme” (din slavul „vremę”)."
      },
      "source": "Etymological Dictionaries, Linguistic Analysis"
    }
  },
