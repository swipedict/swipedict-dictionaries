  "examples": [
    {
      "sourceText": "Komm bitte früher.",
      "targetText": "Vino te rog mai devreme."
    },
    {
      "sourceText": "Früher war alles anders.",
      "targetText": "Înainte era totul altfel."
    },
    {
      "sourceText": "Eine Stunde früher.",
      "targetText": "Cu o oră mai devreme."
    },
    {
      "sourceText": "Je früher, desto besser.",
      "targetText": "Cu cât mai devreme, cu atât mai bine."
    }
  ],
  "learningTips": [
    {
      "lang": "de",
      "text": "Für „früher“ im Sinne von „in der Vergangenheit“ sagt man „înainte“ oder „odinioară“."
    },
    {
      "lang": "de",
      "text": "„devreme“ enthält das slawische „vreme“ (Zeit) – dasselbe Wort wie „Wetter“ im Rumänischen."
    }
