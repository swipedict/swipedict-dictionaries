  "source": {
    "lang": "de",
    "headword": "unser",
    "definition": "Possessivbegleiter der ersten Person Plural: gehört uns.",
    "pronunciation": "/ˈʊnzɐ/",
    "etymology": {
      "explanation": {
        "sourceText": "„Unser“ geht auf althochdeutsch „unsēr“ zurück, gebildet zum Pronomen „wir“.",
        "targetText": "„Unser” provine din germana veche înaltă „unsēr”, format de la pronumele „wir”."
      },
      "source": "Etymological Dictionaries, Linguistic Analysis"
    }
  },
  "target": {
    "lang": "ro",
    "headword": "al nostru",
    "definition": "Pronume posesiv de persoana întâi plural: care ne aparține.",
    "pronunciation": "/al ˈnos.tru/",
    "etymology": {
      "explanation": {
        "sourceText": "Das rumänische „al nostru“ geht auf lateinisch „noster“ zurück, mit dem vorangestellten Possessivartikel „al“.",
        "targetText": "Românescul „al nostru” provine din latinescul „noster”, precedat de articolul posesiv „al”."
      },
      "source": "Etymological Dictionaries, Linguistic Analysis"
    }
  },
