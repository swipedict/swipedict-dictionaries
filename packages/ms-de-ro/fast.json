  "source": {
    "lang": "de",
    "headword": "fast",
    "definition": "Beinahe, nicht ganz vollständig.",
    "pronunciation": "/fast/",
    "etymology": {
      "explanation": {
        "sourceText": "„Fast“ geht auf althochdeutsch „fasto“ („fest, sehr“) zurück; die Bedeutung „beinahe“ ist jünger.",
        "targetText": "„Fast” provine din germana veche înaltă „fasto” („ferm, foarte”); sensul „aproape” este mai recent."
      },
      "source": "Etymological Dictionaries, Linguistic Analysis"
    }
  },
  "target": {
    "lang": "ro",
    "headword": "aproape",
    "definition": "Cât pe ce, nu chiar complet.",
    "pronunciation": "/aˈproa.pe/",
    "etymology": {
      "explanation": {
        "sourceText": "Das rumänische „aproape“ geht auf lateinisch „ad prope“ zurück – „nahe daran“.",
        "targetText": "Românescul „aproape” provine din latinescul „ad prope” – „în apropiere”."
      },
      "source": "Etymological Dictionaries, Linguistic Analysis"
    }
  },
