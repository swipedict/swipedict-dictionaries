  "source": {
    "lang": "de",
    "headword": "schlechter",
    "definition": "Von geringerer Qualität; Komparativ zu „schlecht“.",
    "pronunciation": "/ˈʃlɛçtɐ/",
    "etymology": {
      "explanation": {
        "sourceText": "„Schlecht“ bedeutete althochdeutsch „slecht“ ursprünglich „glatt, einfach“; erst später wurde daraus „minderwertig“.",
        "targetText": "„Schlecht” însemna în germana veche înaltă „slecht” „neted, simplu”; abia mai târziu a devenit „de proastă calitate”."
      },
      "source": "Etymological Dictionaries, Linguistic Analysis"
    }
  },
  "target": {
    "lang": "ro",
    "headword": "mai rău",
    "definition": "De o calitate inferioară; comparativul lui „rău”.",
    "pronunciation": "/maj rəw/",
    "etymology": {
      "explanation": {
        "sourceText": "Die Fügung verbindet „mai“ (< lateinisch „magis“) mit „rău“ (< lateinisch „reus“, schuldig, schlimm).",
        "targetText": "Construcția leagă „mai” (din latinescul „magis”) cu „rău” (din latinescul „reus”, vinovat, rău)."
      },
      "source": "Etymological Dictionaries, Linguistic Analysis"
    }
  },
