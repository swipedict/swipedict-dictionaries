  "source": {
    "lang": "de",
    "headword": "einige",
    "definition": "Eine unbestimmte, aber kleine Zahl von Personen oder Dingen.",
    "pronunciation": "/ˈaɪ̯nɪɡə/",
    "etymology": {
      "explanation": {
        "sourceText": "„Einige“ ist von „ein“ abgeleitet, althochdeutsch „einag“ („einzeln, vereinzelt“).",
        "targetText": "„Einige” este derivat de la „ein”, în germana veche înaltă „einag” („izolat, răzleț”)."
      },
      "source": "Etymological Dictionaries, Linguistic Analysis"
    }
  },
  "target": {
    "lang": "ro",
    "headword": "câțiva",
    "definition": "Un număr nedeterminat, dar mic, de persoane sau lucruri.",
    "pronunciation": "/kɨˈt͡si.va/",
    "etymology": {
      "explanation": {
        "sourceText": "Das rumänische „câțiva“ ist aus „câți“ (< lateinisch „quanti“, wie viele) und der Partikel „-va“ zusammengesetzt.",
        "targetText": "Românescul „câțiva” este format din „câți” (din latinescul „quanti”) și particula „-va”."
      },
      "source": "Etymological Dictionaries, Linguistic Analysis"
    }
  },
