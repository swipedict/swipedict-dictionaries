  "examples": [
    {
      "sourceText": "Einige Freunde kommen.",
      "targetText": "Câțiva prieteni vin."
    },
    {
      "sourceText": "Ich brauche einige Minuten.",
      "targetText": "Am nevoie de câteva minute."
    },
    {
      "sourceText": "Einige sagen das.",
      "targetText": "Unii spun asta."
    },
    {
      "sourceText": "Nach einigen Tagen.",
      "targetText": "După câteva zile."
    }
