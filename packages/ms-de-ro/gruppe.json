  "source": {
    "lang": "de",
    "headword": "Gruppe",
    "definition": "Mehrere Personen oder Dinge, die zusammengehören.",
    "pronunciation": "/ˈɡʁʊpə/",
    "etymology": {
      "explanation": {
        "sourceText": "„Gruppe“ kam über französisch „groupe“ aus italienisch „gruppo“, ursprünglich „Knoten, Klumpen“.",
        "targetText": "„Gruppe” a ajuns prin franceză („groupe”) din italianul „gruppo”, inițial „nod, boț”."
      },
      "source": "Etymological Dictionaries, Linguistic Analysis"
    },
    "genus": "feminine"
  },
  "target": {
    "lang": "ro",
    "headword": "grup",
    "definition": "Mai multe persoane sau lucruri care formează un tot.",
    "pronunciation": "/ɡrup/",
    "etymology": {
      "explanation": {
        "sourceText": "Das rumänische „grup“ ist aus dem Französischen „groupe“ entlehnt; das Wort geht letztlich auf ein germanisches „kruppa“ („Klumpen“) zurück.",
        "targetText": "Românescul „grup” este împrumutat din franceză, din „groupe”; cuvântul provine în ultimă instanță dintr-un germanic „kruppa” („boț”)."
      },
      "source": "Etymological Dictionaries, Linguistic Analysis"
    },
    "genus": "neuter"
  },
