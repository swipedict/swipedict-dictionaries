  "source": {
    "lang": "de",
    "headword": "dunkel",
    "definition": "Ohne oder mit wenig Licht.",
    "pronunciation": "/ˈdʊŋkl̩/",
    "etymology": {
      "explanation": {
        "sourceText": "„Dunkel“ geht auf althochdeutsch „tunkal“ zurück, ein gemeingermanisches Wort.",
        "targetText": "„Dunkel” provine din germana veche înaltă „tunkal”, cuvânt comun germanic."
      },
      "source": "Etymological Dictionaries, Linguistic Analysis"
    }
  },
  "target": {
    "lang": "ro",
    "headword": "întunecat",
    "definition": "Fără lumină sau cu puțină lumină.",
    "pronunciation": "/ɨn.tu.neˈkat/",
    "etymology": {
      "explanation": {
        "sourceText": "Das rumänische „întunecat“ ist das Partizip von „a întuneca“, gebildet zu „întuneric“ (< vulgärlateinisch „*intunicare“).",
        "targetText": "Românescul „întunecat” este participiul verbului „a întuneca”, format de la „întuneric” (din latinescul popular „*intunicare”)."
      },
      "source": "Etymological Dictionaries, Linguistic Analysis"
    }
  },
