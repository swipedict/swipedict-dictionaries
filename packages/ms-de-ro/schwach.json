  "source": {
    "lang": "de",
    "headword": "schwach",
    "definition": "Ohne Kraft oder Stärke; auch: mager.",
    "pronunciation": "/ʃvax/",
    "etymology": {
      "explanation": {
        "sourceText": "„Schwach“ geht auf althochdeutsch „swah“ („kraftlos“) zurück.",
        "targetText": "„Schwach” provine din germana veche înaltă „swah” („fără putere”)."
      },
      "source": "Etymological Dictionaries, Linguistic Analysis"
    }
  },
  "target": {
    "lang": "ro",
    "headword": "slab",
    "definition": "Fără putere sau forță; de asemenea: slăbuț.",
    "pronunciation": "/slab/",
    "etymology": {
      "explanation": {
        "sourceText": "Das rumänische „slab“ ist ein slawisches Lehnwort aus „slabŭ“ („schwach“) und deckt auch die Bedeutung „mager“ ab.",
        "targetText": "Românescul „slab” este un împrumut slav din „slabŭ” („slab”) și acoperă și sensul de „subțire, costeliv”."
      },
      "source": "Etymological Dictionaries, Linguistic Analysis"
    }
  },
