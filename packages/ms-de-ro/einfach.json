  "source": {
    "lang": "de",
    "headword": "einfach",
    "definition": "Nicht kompliziert; leicht zu verstehen oder zu tun.",
    "pronunciation": "/ˈaɪ̯nfax/",
    "etymology": {
      "explanation": {
        "sourceText": "„Einfach“ ist aus „ein“ und „-fach“ zusammengesetzt – „nur einmal gefaltet“.",
        "targetText": "„Einfach” este compus din „ein” și „-fach” – „îndoit o singură dată”."
      },
      "source": "Etymological Dictionaries, Linguistic Analysis"
    }
  },
  "target": {
    "lang": "ro",
    "headword": "simplu",
    "definition": "Care nu este complicat; ușor de înțeles sau de făcut.",
    "pronunciation": "/ˈsim.plu/",
    "etymology": {
      "explanation": {
        "sourceText": "Das rumänische „simplu“ ist aus dem Französischen „simple“ entlehnt; die lateinische Wurzel „simplus“ heißt ebenfalls „einfach gefaltet“.",
        "targetText": "Românescul „simplu” este împrumutat din franceză, din „simple”; rădăcina latină „simplus” înseamnă tot „îndoit o dată”."
      },
      "source": "Etymological Dictionaries, Linguistic Analysis"
    }
  },
