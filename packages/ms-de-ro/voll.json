  "source": {
    "lang": "de",
    "headword": "voll",
    "definition": "So gefüllt, dass kein Platz mehr ist.",
    "pronunciation": "/fɔl/",
    "etymology": {
      "explanation": {
        "sourceText": "„Voll“ geht auf althochdeutsch „fol“ zurück, urverwandt mit lateinisch „plenus“.",
        "targetText": "„Voll” provine din germana veche înaltă „fol”, înrudit din vechime cu latinescul „plenus”."
      },
      "source": "Etymological Dictionaries, Linguistic Analysis"
    }
  },
  "target": {
    "lang": "ro",
    "headword": "plin",
    "definition": "Umplut astfel încât nu mai este loc.",
    "pronunciation": "/plin/",
    "etymology": {
      "explanation": {
        "sourceText": "Das rumänische „plin“ stammt vom lateinischen „plenus“ – demselben Wort, mit dem auch deutsch „voll“ urverwandt ist.",
        "targetText": "Românescul „plin” provine din latinescul „plenus” – același cuvânt cu care este înrudit și germanul „voll”."
      },
      "source": "Etymological Dictionaries, Linguistic Analysis"
    }
  },
