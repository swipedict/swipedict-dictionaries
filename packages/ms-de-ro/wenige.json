  "source": {
    "lang": "de",
    "headword": "wenige",
    "definition": "Eine kleine Anzahl von Personen oder Dingen.",
    "pronunciation": "/ˈveːnɪɡə/",
    "etymology": {
      "explanation": {
        "sourceText": "„Wenig“ geht auf althochdeutsch „wēnag“ zurück, ursprünglich „beklagenswert, gering“.",
        "targetText": "„Wenig” provine din germana veche înaltă „wēnag”, inițial „vrednic de plâns, mic”."
      },
      "source": "Etymological Dictionaries, Linguistic Analysis"
    }
  },
  "target": {
    "lang": "ro",
    "headword": "puțini",
    "definition": "Un număr mic de persoane sau lucruri.",
    "pronunciation": "/puˈt͡sinʲ/",
    "etymology": {
      "explanation": {
        "sourceText": "Das rumänische „puțin“ stammt vom lateinischen „putinnus“, einer Nebenform zu „putus“ („klein, Knabe“).",
        "targetText": "Românescul „puțin” provine din latinescul „putinnus”, variantă a lui „putus” („mic, băiețel”)."
      },
      "source": "Etymological Dictionaries, Linguistic Analysis"
    }
  },
