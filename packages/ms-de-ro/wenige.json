  "examples": [
    {
      "sourceText": "Wenige Leute kamen.",
      "targetText": "Puțini oameni au venit."
    },
    {
      "sourceText": "Ich habe wenig Zeit.",
      "targetText": "Am puțin timp."
    },
    {
      "sourceText": "Ein bisschen Salz.",
      "targetText": "Puțină sare."
    },
    {
      "sourceText": "Nur wenige verstehen das.",
      "targetText": "Doar puțini înțeleg asta."
    }
  ],
  "learningTips": [
    {
      "lang": "de",
      "text": "Formen: puțin, puțină, puțini, puține."
    },
    {
      "lang": "de",
      "text": "„puțin“ allein heißt auch „ein bisschen“: „mai puțin sare“ = etwas weniger Salz."
    }
