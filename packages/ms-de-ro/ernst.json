  "source": {
    "lang": "de",
    "headword": "ernst",
    "definition": "Nicht scherzhaft; von Gewicht und Bedeutung.",
    "pronunciation": "/ɛʁnst/",
    "etymology": {
      "explanation": {
        "sourceText": "„Ernst“ geht auf althochdeutsch „ernust“ („Kampf, Eifer“) zurück.",
        "targetText": "„Ernst” provine din germana veche înaltă „ernust” („luptă, râvnă”)."
      },
      "source": "Etymological Dictionaries, Linguistic Analysis"
    }
  },
  "target": {
    "lang": "ro",
    "headword": "serios",
    "definition": "Care nu este în glumă; important și grav.",
    "pronunciation": "/seˈri.os/",
    "etymology": {
      "explanation": {
        "sourceText": "Das rumänische „serios“ ist aus dem Französischen „sérieux“ entlehnt; die lateinische Wurzel ist „serius“.",
        "targetText": "Românescul „serios” este împrumutat din franceză, din „sérieux”; rădăcina latină este „serius”."
      },
      "source": "Etymological Dictionaries, Linguistic Analysis"
    }
  },
