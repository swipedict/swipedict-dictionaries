  "source": {
    "lang": "de",
    "headword": "unten",
    "definition": "An einer tiefer gelegenen Stelle.",
    "pronunciation": "/ˈʊntn̩/",
    "etymology": {
      "explanation": {
        "sourceText": "„Unten“ geht auf althochdeutsch „untana“ zurück, zur Präposition „unter“.",
        "targetText": "„Unten” provine din germana veche înaltă „untana”, de la prepoziția „unter”."
      },
      "source": "Etymological Dictionaries, Linguistic Analysis"
    }
  },
  "target": {
    "lang": "ro",
    "headword": "jos",
    "definition": "Într-un loc situat mai jos.",
    "pronunciation": "/ʒos/",
    "etymology": {
      "explanation": {
        "sourceText": "Das rumänische „jos“ geht auf lateinisch „deorsum“ („abwärts“) zurück.",
        "targetText": "Românescul „jos” provine din latinescul „deorsum” („în jos”)."
      },
      "source": "Etymological Dictionaries, Linguistic Analysis"
    }
  },
