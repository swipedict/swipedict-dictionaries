  "learningTips": [
    {
      "lang": "de",
      "text": "„Stai jos!“ heißt „Setz dich!“ – wörtlich „bleib unten“."
    },
    {
      "lang": "de",
      "text": "„în jos“ ist die Richtung: „mergem în jos“ = wir gehen hinunter."
