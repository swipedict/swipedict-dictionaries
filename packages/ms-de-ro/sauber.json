  "source": {
    "lang": "de",
    "headword": "sauber",
    "definition": "Frei von Schmutz.",
    "pronunciation": "/ˈzaʊ̯bɐ/",
    "etymology": {
      "explanation": {
        "sourceText": "„Sauber“ geht auf althochdeutsch „sūbar“ zurück, ein frühes Lehnwort aus lateinisch „sobrius“ („nüchtern“).",
        "targetText": "„Sauber” provine din germana veche înaltă „sūbar”, împrumut timpuriu din latinescul „sobrius” („sobru”)."
      },
      "source": "Etymological Dictionaries, Linguistic Analysis"
    }
  },
  "target": {
    "lang": "ro",
    "headword": "curat",
    "definition": "Fără murdărie.",
    "pronunciation": "/kuˈrat/",
    "etymology": {
      "explanation": {
        "sourceText": "Das rumänische „curat“ ist das Partizip von „a cura“ (< lateinisch „curare“, pflegen) – wörtlich „gepflegt“.",
        "targetText": "Românescul „curat” este participiul verbului „a cura” (din latinescul „curare”, a îngriji) – literal „îngrijit”."
      },
      "source": "Etymological Dictionaries, Linguistic Analysis"
    }
  },
