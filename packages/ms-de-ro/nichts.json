  "source": {
    "lang": "de",
    "headword": "nichts",
    "definition": "Kein Ding, keine Sache; das Gegenteil von etwas.",
    "pronunciation": "/nɪçts/",
    "etymology": {
      "explanation": {
        "sourceText": "„Nichts“ ist der erstarrte Genitiv von „nicht“, das aus „ni“ (nicht) und „wiht“ (Ding) entstand.",
        "targetText": "„Nichts” este genitivul încremenit al lui „nicht”, provenit din „ni” (nu) și „wiht” (lucru)."
      },
      "source": "Etymological Dictionaries, Linguistic Analysis"
    }
  },
  "target": {
    "lang": "ro",
    "headword": "nimic",
    "definition": "Niciun lucru; contrariul lui „ceva”.",
    "pronunciation": "/niˈmik/",
    "etymology": {
      "explanation": {
        "sourceText": "Das rumänische „nimic“ geht auf lateinisch „nec mica“ zurück – wörtlich „nicht ein Krümel“.",
        "targetText": "Românescul „nimic” provine din latinescul „nec mica” – literal „nici o firimitură”."
      },
      "source": "Etymological Dictionaries, Linguistic Analysis"
    }
  },
