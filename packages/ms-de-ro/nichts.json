  "examples": [
    {
      "sourceText": "Ich verstehe nichts.",
      "targetText": "Eu nu înțeleg nimic."
    },
    {
      "sourceText": "Es gibt nichts zu essen.",
      "targetText": "Nu este nimic de mâncare."
    },
    {
      "sourceText": "Nichts ist unmöglich.",
      "targetText": "Nimic nu este imposibil."
    },
    {
      "sourceText": "Danke! – Nichts zu danken.",
      "targetText": "Mulțumesc! – Nu ai pentru ce."
    }
  ],
  "learningTips": [
    {
      "lang": "de",
      "text": "Auch hier doppelte Verneinung: „nu înțeleg nimic“ – wörtlich „ich verstehe nicht nichts“."
    },
    {
      "lang": "de",
      "text": "Schöne Merkhilfe: „nimic“ kommt von „nicht ein Krümel“ (lat. nec mica)."
    }
