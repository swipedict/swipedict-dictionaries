  "source": {
    "lang": "de",
    "headword": "leer",
    "definition": "Ohne Inhalt; auch: unbekleidet, nackt.",
    "pronunciation": "/leːɐ̯/",
    "etymology": {
      "explanation": {
        "sourceText": "„Leer“ geht auf althochdeutsch „lāri“ zurück, verwandt mit „lesen“ im Sinne von „auflesen“.",
        "targetText": "„Leer” provine din germana veche înaltă „lāri”, înrudit cu „lesen” în sensul de „a aduna”."
      },
      "source": "Etymological Dictionaries, Linguistic Analysis"
    }
  },
  "target": {
    "lang": "ro",
    "headword": "gol",
    "definition": "Fără conținut; de asemenea: fără haine, dezbrăcat.",
    "pronunciation": "/ɡol/",
    "etymology": {
      "explanation": {
        "sourceText": "Das rumänische „gol“ ist ein slawisches Lehnwort aus „golŭ“ („nackt, bloß“) und heißt sowohl „leer“ als auch „nackt“.",
        "targetText": "Românescul „gol” este un împrumut slav din „golŭ” („gol, dezgolit”) și înseamnă atât „gol”, cât și „dezbrăcat”."
      },
      "source": "Etymological Dictionaries, Linguistic Analysis"
    }
  },
