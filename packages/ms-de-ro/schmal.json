  "source": {
    "lang": "de",
    "headword": "schmal",
    "definition": "Von geringer Ausdehnung von einer Seite zur anderen.",
    "pronunciation": "/ʃmaːl/",
    "etymology": {
      "explanation": {
        "sourceText": "„Schmal“ geht auf althochdeutsch „smal“ zurück, verwandt mit englisch „small“.",
        "targetText": "„Schmal” provine din germana veche înaltă „smal”, înrudit cu englezescul „small”."
      },
      "source": "Etymological Dictionaries, Linguistic Analysis"
    }
  },
  "target": {
    "lang": "ro",
    "headword": "îngust",
    "definition": "Care are o întindere mică dintr-o parte în alta.",
    "pronunciation": "/ɨnˈɡust/",
    "etymology": {
      "explanation": {
        "sourceText": "Das rumänische „îngust“ geht auf lateinisch „angustus“ („eng“) zurück – dieselbe Wurzel wie in „Angst“.",
        "targetText": "Românescul „îngust” provine din latinescul „angustus” („strâmt”) – aceeași rădăcină ca în germanul „Angst”."
      },
      "source": "Etymological Dictionaries, Linguistic Analysis"
    }
  },
