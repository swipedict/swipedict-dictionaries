  "source": {
    "lang": "de",
    "headword": "oben",
    "definition": "An einer höher gelegenen Stelle.",
    "pronunciation": "/ˈoːbn̩/",
    "etymology": {
      "explanation": {
        "sourceText": "„Oben“ geht auf althochdeutsch „obana“ zurück, zur Präposition „ob“ (über).",
        "targetText": "„Oben” provine din germana veche înaltă „obana”, de la prepoziția „ob” (deasupra)."
      },
      "source": "Etymological Dictionaries, Linguistic Analysis"
    }
  },
  "target": {
    "lang": "ro",
    "headword": "sus",
    "definition": "Într-un loc situat mai înalt.",
    "pronunciation": "/sus/",
    "etymology": {
      "explanation": {
        "sourceText": "Das rumänische „sus“ stammt vom lateinischen „susum“, einer Nebenform von „sursum“ („aufwärts“).",
        "targetText": "Românescul „sus” provine din latinescul „susum”, variantă a lui „sursum” („în sus”)."
      },
      "source": "Etymological Dictionaries, Linguistic Analysis"
    }
  },
