  "learningTips": [
    {
      "lang": "de",
      "text": "„sus“ und „jos“ sind das Grundpaar für oben/unten – kurz und sehr häufig."
    },
    {
      "lang": "de",
      "text": "„în sus“ heißt „nach oben“ als Richtung: „mâinile în sus“."
