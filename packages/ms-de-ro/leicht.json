  "source": {
    "lang": "de",
    "headword": "leicht",
    "definition": "Von geringem Gewicht; auch: nicht schwierig.",
    "pronunciation": "/laɪ̯çt/",
    "etymology": {
      "explanation": {
        "sourceText": "„Leicht“ geht auf althochdeutsch „līht“ zurück, urverwandt mit lateinisch „levis“.",
        "targetText": "„Leicht” provine din germana veche înaltă „līht”, înrudit cu latinescul „levis”."
      },
      "source": "Etymological Dictionaries, Linguistic Analysis"
    }
  },
  "target": {
    "lang": "ro",
    "headword": "ușor",
    "definition": "Care are o greutate mică; de asemenea: nu dificil.",
    "pronunciation": "/uˈʃor/",
    "etymology": {
      "explanation": {
        "sourceText": "Das rumänische „ușor“ ist ein lateinisches Erbwort und hat wie das deutsche „leicht“ beide Bedeutungen: geringes Gewicht und geringe Mühe.",
        "targetText": "Românescul „ușor” este un cuvânt moștenit din latină și are, ca și germanul „leicht”, ambele sensuri: greutate mică și efort mic."
      },
      "source": "Etymological Dictionaries, Linguistic Analysis"
    }
  },
