  "source": {
    "lang": "de",
    "headword": "manchmal",
    "definition": "Von Zeit zu Zeit, nicht regelmäßig.",
    "pronunciation": "/ˈmançmaːl/",
    "etymology": {
      "explanation": {
        "sourceText": "„Manchmal“ ist aus „manch“ und „Mal“ zusammengesetzt – „manches Mal“.",
        "targetText": "„Manchmal” este compus din „manch” și „Mal” – „unele dăți”."
      },
      "source": "Etymological Dictionaries, Linguistic Analysis"
    }
  },
  "target": {
    "lang": "ro",
    "headword": "uneori",
    "definition": "Din când în când, nu în mod regulat.",
    "pronunciation": "/u.neˈorʲ/",
    "etymology": {
      "explanation": {
        "sourceText": "Das rumänische „uneori“ ist aus „un“ (< lateinisch „unus“) und „ori“ (< lateinisch „horae“, Stunden) gebildet.",
        "targetText": "Românescul „uneori” este format din „un” (din latinescul „unus”) și „ori” (din „horae”, ore)."
      },
      "source": "Etymological Dictionaries, Linguistic Analysis"
    }
  },
