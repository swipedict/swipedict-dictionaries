  "source": {
    "lang": "de",
    "headword": "billig",
    "definition": "Was wenig Geld kostet.",
    "pronunciation": "/ˈbɪlɪç/",
    "etymology": {
      "explanation": {
        "sourceText": "„Billig“ bedeutete ursprünglich „angemessen, recht“ (daher „Recht und Billigkeit“); erst später wurde daraus „niedrig im Preis“.",
        "targetText": "„Billig” însemna inițial „potrivit, drept”; abia mai târziu a căpătat sensul „cu preț mic”."
      },
      "source": "Etymological Dictionaries, Linguistic Analysis"
    }
  },
  "target": {
    "lang": "ro",
    "headword": "ieftin",
    "definition": "Care costă puțini bani.",
    "pronunciation": "/ˈjef.tin/",
    "etymology": {
      "explanation": {
        "sourceText": "Das rumänische „ieftin“ stammt aus dem Neugriechischen „eftinos“ („wohlfeil“).",
        "targetText": "Românescul „ieftin” provine din neogrecescul „eftinos” („cu preț mic”)."
      },
      "source": "Etymological Dictionaries, Linguistic Analysis"
    }
  },
