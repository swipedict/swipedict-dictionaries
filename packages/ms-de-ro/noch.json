  "source": {
    "lang": "de",
    "headword": "noch",
    "definition": "Bis zu diesem Zeitpunkt weiterhin; zusätzlich.",
    "pronunciation": "/nɔx/",
    "etymology": {
      "explanation": {
        "sourceText": "„Noch“ geht auf althochdeutsch „noh“ zurück, zusammengesetzt aus „nu“ (jetzt) und einer verstärkenden Partikel.",
        "targetText": "„Noch” provine din germana veche înaltă „noh”, compus din „nu” (acum) și o particulă de întărire."
      },
      "source": "Etymological Dictionaries, Linguistic Analysis"
    }
  },
  "target": {
    "lang": "ro",
    "headword": "încă",
    "definition": "Până în acest moment, în continuare; în plus.",
    "pronunciation": "/ˈɨn.kə/",
    "etymology": {
      "explanation": {
        "sourceText": "Das rumänische „încă“ geht auf lateinisch „hanc hora“ („zu dieser Stunde“) zurück.",
        "targetText": "Românescul „încă” provine din latinescul „hanc hora” („la această oră”)."
      },
      "source": "Etymological Dictionaries, Linguistic Analysis"
    }
  },
  "senses": [],
  "relatedWords": [
    {
