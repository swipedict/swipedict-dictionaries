  ],
  "examples": [
    {
      "sourceText": "Er ist noch hier.",
      "targetText": "El este încă aici."
    },
    {
      "sourceText": "Noch ein Kaffee, bitte.",
      "targetText": "Încă o cafea, vă rog."
    },
    {
      "sourceText": "Ich bin noch nicht fertig.",
      "targetText": "Nu sunt încă gata."
    },
    {
      "sourceText": "Wir haben noch Zeit.",
      "targetText": "Mai avem încă timp."
    }
  ],
  "learningTips": [
    {
      "lang": "de",
      "text": "„încă un/o“ heißt „noch ein“: „încă o cafea“."
    },
    {
      "lang": "de",
      "text": "„încă nu“ = „noch nicht“ – die häufigste Verneinung dazu."
    }
