  "source": {
    "lang": "de",
    "headword": "Hoffnung",
    "definition": "Erwartung, dass etwas Gutes geschieht.",
    "pronunciation": "/ˈhɔfnʊŋ/",
    "etymology": {
      "explanation": {
        "sourceText": "„Hoffnung“ ist von „hoffen“ abgeleitet, mittelniederdeutsch „hopen“ – ursprünglich „vor Erwartung hüpfen“.",
        "targetText": "„Hoffnung” este derivat de la „hoffen”, în germana medie de jos „hopen” – inițial „a sălta de așteptare”."
      },
      "source": "Etymological Dictionaries, Linguistic Analysis"
    },
    "genus": "feminine"
  },
  "target": {
    "lang": "ro",
    "headword": "speranță",
    "definition": "Așteptarea ca ceva bun să se întâmple.",
    "pronunciation": "/speˈran.t͡sə/",
    "etymology": {
      "explanation": {
        "sourceText": "Das rumänische „speranță“ ist aus dem Italienischen „speranza“ entlehnt; die lateinische Wurzel „sperare“ heißt „hoffen“.",
        "targetText": "Românescul „speranță” este împrumutat din italianul „speranza”; rădăcina latină „sperare” înseamnă „a spera”."
      },
      "source": "Etymological Dictionaries, Linguistic Analysis"
    },
    "genus": "feminine"
  },
