  "source": {
    "lang": "de",
    "headword": "denn",
    "definition": "Konjunktion, die eine Begründung anschließt.",
    "pronunciation": "/dɛn/",
    "etymology": {
      "explanation": {
        "sourceText": "„Denn“ und „dann“ waren ursprünglich dasselbe Wort, althochdeutsch „danne“.",
        "targetText": "„Denn” și „dann” erau inițial același cuvânt, în germana veche înaltă „danne”."
      },
      "source": "Etymological Dictionaries, Linguistic Analysis"
    }
  },
  "target": {
    "lang": "ro",
    "headword": "căci",
    "definition": "Conjuncție care introduce o justificare.",
    "pronunciation": "/kət͡ʃʲ/",
    "etymology": {
      "explanation": {
        "sourceText": "Das rumänische „căci“ ist aus „că“ (< lateinisch „quod“) und „ce“ (< lateinisch „quid“) zusammengewachsen.",
        "targetText": "Românescul „căci” s-a format prin sudarea lui „că” (din latinescul „quod”) cu „ce” (din „quid”)."
      },
      "source": "Etymological Dictionaries, Linguistic Analysis"
    }
  },
  "senses": [],
