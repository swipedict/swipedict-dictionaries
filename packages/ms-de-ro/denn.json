  "antonyms": [],
  "examples": [
    {
      "sourceText": "Ich bleibe, denn es regnet.",
      "targetText": "Rămân, căci plouă."
    },
    {
      "sourceText": "Er schwieg, denn er war müde.",
      "targetText": "A tăcut, căci era obosit."
    },
    {
      "sourceText": "Wir gehen, denn es ist spät.",
      "targetText": "Plecăm, căci este târziu."
    },
    {
      "sourceText": "Sie lacht, denn sie ist glücklich.",
      "targetText": "Râde, căci este fericită."
    }
  ],
  "learningTips": [
    {
      "lang": "de",
      "text": "„căci“ klingt gehoben; im Alltag sagt man „pentru că“."
    },
    {
      "lang": "de",
      "text": "Wie deutsch „denn“ steht „căci“ nur zwischen zwei Hauptsätzen, nie am Satzanfang."
    }
