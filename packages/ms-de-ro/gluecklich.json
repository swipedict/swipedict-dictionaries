  "source": {
    "lang": "de",
    "headword": "glücklich",
    "definition": "Voller Freude und Zufriedenheit.",
    "pronunciation": "/ˈɡlʏklɪç/",
    "etymology": {
      "explanation": {
        "sourceText": "„Glücklich“ ist von „Glück“ abgeleitet, mittelhochdeutsch „gelücke“ („günstiger Ausgang“).",
        "targetText": "„Glücklich” este derivat de la „Glück”, în germana medie „gelücke” („deznodământ favorabil”)."
      },
      "source": "Etymological Dictionaries, Linguistic Analysis"
    }
  },
  "target": {
    "lang": "ro",
    "headword": "fericit",
    "definition": "Plin de bucurie și mulțumire.",
    "pronunciation": "/fe.riˈt͡ʃit/",
    "etymology": {
      "explanation": {
        "sourceText": "Das rumänische „fericit“ ist das Partizip von „a ferici“, das auf lateinisch „felix, felicis“ („glücklich“) zurückgeht.",
        "targetText": "Românescul „fericit” este participiul verbului „a ferici”, din latinescul „felix, felicis” („fericit”)."
      },
      "source": "Etymological Dictionaries, Linguistic Analysis"
    }
  },
