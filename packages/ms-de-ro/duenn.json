  "source": {
    "lang": "de",
    "headword": "dünn",
    "definition": "Von geringer Dicke.",
    "pronunciation": "/dʏn/",
    "etymology": {
      "explanation": {
        "sourceText": "„Dünn“ geht auf althochdeutsch „dunni“ zurück, urverwandt mit lateinisch „tenuis“.",
        "targetText": "„Dünn” provine din germana veche înaltă „dunni”, înrudit cu latinescul „tenuis”."
      },
      "source": "Etymological Dictionaries, Linguistic Analysis"
    }
  },
  "target": {
    "lang": "ro",
    "headword": "subțire",
    "definition": "Care are o grosime mică.",
    "pronunciation": "/subˈt͡si.re/",
    "etymology": {
      "explanation": {
        "sourceText": "Das rumänische „subțire“ geht auf lateinisch „subtilis“ zurück, das „fein gewebt“ bedeutete – daher auch deutsch „subtil“.",
        "targetText": "Românescul „subțire” provine din latinescul „subtilis”, care însemna „țesut fin” – de aici și „subtil”."
      },
      "source": "Etymological Dictionaries, Linguistic Analysis"
    }
  },
