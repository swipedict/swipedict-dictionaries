  "source": {
    "lang": "de",
    "headword": "Frau",
    "definition": "Erwachsener Mensch weiblichen Geschlechts.",
    "pronunciation": "/fʁaʊ̯/",
    "etymology": {
      "explanation": {
        "sourceText": "„Frau“ geht auf althochdeutsch „frouwa“ („Herrin“) zurück, die weibliche Form zu „fro“ („Herr“).",
        "targetText": "„Frau” provine din germana veche înaltă „frouwa” („stăpână”), forma feminină a lui „fro” („stăpân”)."
      },
      "source": "Etymological Dictionaries, Linguistic Analysis"
    },
    "genus": "feminine"
  },
  "target": {
    "lang": "ro",
    "headword": "femeie",
    "definition": "Persoană adultă de sex feminin.",
    "pronunciation": "/feˈme.je/",
    "etymology": {
      "explanation": {
        "sourceText": "Das rumänische „femeie“ stammt vom lateinischen „familia“, das im Vulgärlateinischen die Bedeutung „Hausgemeinschaft“ zu „Ehefrau, Frau“ verengte.",
        "targetText": "Românescul „femeie” provine din latinescul „familia”, al cărui sens de „gospodărie” s-a îngustat în latina populară la „soție, femeie”."
      },
      "source": "Etymological Dictionaries, Linguistic Analysis"
    },
    "genus": "feminine"
  },
