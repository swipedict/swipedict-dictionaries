  "examples": [
    {
      "sourceText": "Die Frau liest ein Buch.",
      "targetText": "Femeia citește o carte."
    },
    {
      "sourceText": "Sie ist eine starke Frau.",
      "targetText": "Ea este o femeie puternică."
    },
    {
      "sourceText": "Zwei Frauen warten draußen.",
      "targetText": "Două femei așteaptă afară."
    },
    {
      "sourceText": "Meine Frau heißt Ana.",
      "targetText": "Soția mea se numește Ana."
    }
  ],
  "learningTips": [
    {
      "lang": "de",
      "text": "Vorsicht: „femeie“ heißt „Frau“ im Sinne von weiblicher Mensch. Die Ehefrau ist „soție“ – nicht wie im Deutschen dasselbe Wort."
    },
    {
      "lang": "de",
      "text": "„femeie“ und „Familie“ haben dieselbe lateinische Wurzel „familia“."
    }
  ],
