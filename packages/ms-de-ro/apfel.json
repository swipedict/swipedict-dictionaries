  "examples": [
    {
      "sourceText": "Ich esse einen Apfel.",
      "targetText": "Mănânc un măr."
    },
    {
      "sourceText": "Rote Äpfel.",
      "targetText": "Mere roșii."
    },
    {
      "sourceText": "Der Apfelbaum blüht.",
      "targetText": "Mărul înflorește."
    },
    {
      "sourceText": "Apfelsaft, bitte.",
