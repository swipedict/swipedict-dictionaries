  "source": {
    "lang": "de",
    "headword": "Apfel",
    "definition": "Runde, meist rote oder grüne Baumfrucht.",
    "pronunciation": "/ˈap͡fl̩/",
    "etymology": {
      "explanation": {
        "sourceText": "„Apfel“ geht auf althochdeutsch „apful“ zurück, ein altes westgermanisches Wort.",
        "targetText": "„Apfel” provine din germana veche înaltă „apful”, cuvânt vechi vest-germanic."
      },
      "source": "Etymological Dictionaries, Linguistic Analysis"
    },
    "genus": "masculine"
  },
  "target": {
    "lang": "ro",
    "headword": "măr",
    "definition": "Fruct rotund de pom, de obicei roșu sau verde.",
    "pronunciation": "/mər/",
    "etymology": {
      "explanation": {
        "sourceText": "Das rumänische „măr“ stammt vom lateinischen „melum“ (klassisch „malum“, Apfel), das seinerseits aus dem Griechischen entlehnt war.",
        "targetText": "Românescul „măr” provine din latinescul „melum” (clasic „malum”, măr), împrumutat la rândul lui din greacă."
      },
      "source": "Etymological Dictionaries, Linguistic Analysis"
    },
    "genus": "neuter"
  },
