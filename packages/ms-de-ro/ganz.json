  "examples": [
    {
      "sourceText": "Die ganze Stadt schläft.",
      "targetText": "Întregul oraș doarme."
    },
    {
      "sourceText": "Ein ganzes Jahr.",
      "targetText": "Un an întreg."
    },
    {
