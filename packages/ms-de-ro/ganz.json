  "source": {
    "lang": "de",
    "headword": "ganz",
    "definition": "Vollständig, ohne fehlenden Teil.",
    "pronunciation": "/ɡant͡s/",
    "etymology": {
      "explanation": {
        "sourceText": "„Ganz“ geht auf althochdeutsch „ganz“ („unversehrt“) zurück.",
        "targetText": "„Ganz” provine din germana veche înaltă „ganz” („nevătămat”)."
      },
      "source": "Etymological Dictionaries, Linguistic Analysis"
    }
  },
  "target": {
    "lang": "ro",
    "headword": "întreg",
    "definition": "Complet, fără nicio parte lipsă.",
    "pronunciation": "/ɨnˈtreɡ/",
    "etymology": {
      "explanation": {
        "sourceText": "Das rumänische „întreg“ stammt vom lateinischen „integrum“ („unberührt, vollständig“) – dieselbe Wurzel wie in „integral“.",
        "targetText": "Românescul „întreg” provine din latinescul „integrum” („neatins, complet”) – aceeași rădăcină ca în „integral”."
      },
      "source": "Etymological Dictionaries, Linguistic Analysis"
    }
  },
