  "learningTips": [
    {
      "lang": "de",
      "text": "Für „die ganze Stadt“ sagt man meist „tot orașul“ – „întreg“ klingt etwas gehobener."
    },
    {
      "lang": "de",
      "text": "Merke „integrum“: dieselbe Wurzel wie deutsch „integer“ und „Integral“."
