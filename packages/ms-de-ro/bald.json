  "source": {
    "lang": "de",
    "headword": "bald",
    "definition": "In kurzer Zeit, nach nicht langer Zeit.",
    "pronunciation": "/balt/",
    "etymology": {
      "explanation": {
        "sourceText": "„Bald“ geht auf althochdeutsch „bald“ („kühn, schnell“) zurück – aus „kühn“ wurde „rasch“.",
        "targetText": "„Bald” provine din germana veche înaltă „bald” („îndrăzneț, iute”); din „îndrăzneț” a rezultat „repede”."
      },
      "source": "Etymological Dictionaries, Linguistic Analysis"
    }
  },
  "target": {
    "lang": "ro",
    "headword": "curând",
    "definition": "Peste puțin timp, într-un interval scurt.",
    "pronunciation": "/kuˈrɨnd/",
    "etymology": {
      "explanation": {
        "sourceText": "Das rumänische „curând“ geht auf lateinisch „currendo“ („laufend“) zurück – wörtlich „im Laufschritt“.",
        "targetText": "Românescul „curând” provine din latinescul „currendo” („alergând”) – literal „în fugă”."
      },
      "source": "Etymological Dictionaries, Linguistic Analysis"
    }
  },
