    "headword": "schmutzig",
    "definition": "Mit Schmutz bedeckt, nicht sauber.",
    "pronunciation": "/ˈʃmʊt͡sɪç/",
    "etymology": {
      "explanation": {
        "sourceText": "„Schmutzig“ ist von „Schmutz“ abgeleitet, mittelhochdeutsch „smuz“.",
        "targetText": "„Schmutzig” este derivat de la „Schmutz”, în germana medie „smuz”."
      },
      "source": "Etymological Dictionaries, Linguistic Analysis"
    }
  },
  "target": {
    "lang": "ro",
    "headword": "murdar",
    "definition": "Acoperit de murdărie, care nu este curat.",
    "pronunciation": "/murˈdar/",
    "etymology": {
      "explanation": {
        "sourceText": "Das rumänische „murdar“ ist aus dem Türkischen „murdar“ („unrein“) entlehnt, das seinerseits aus dem Persischen stammt.",
        "targetText": "Românescul „murdar” este împrumutat din turcescul „murdar” („necurat”), la rândul lui de origine persană."
      },
      "source": "Etymological Dictionaries, Linguistic Analysis"
    }
  },
