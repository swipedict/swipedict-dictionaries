    "headword": "îngrijit",
    "definition": "bine organizat sau curat, structurat și nu haotic",
    "pronunciation": "/ɨnɡriˈʤit/",
    "etymology": {
      "text": "Adjectivul „îngrijit” este participiul lui „a îngriji”, format de la „grijă”, împrumutat din slavonă („griža”).",
      "source": "Etymological Dictionaries, Linguistic Analysis"
    },
    "genus": "masculine"
  },
  "examples": [
    {
      "text": "O cameră îngrijită încurajează concentrarea."
    },
    {
      "text": "Este important să lucrezi îngrijit."
    },
    {
      "text": "Înregistrările îngrijite sunt necesare pentru contabilitate."
    },
    {
      "text": "Ea este o persoană foarte îngrijită."
