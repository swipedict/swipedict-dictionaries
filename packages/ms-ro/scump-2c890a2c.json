  "data": {
    "headword": "scump",
    "definition": "Care costă mulți bani.",
    "pronunciation": "/skump/",
    "etymology": {
      "text": "Românescul „scump” este un împrumut slav, din slavona veche „skǫpŭ” („zgârcit, puțin”). De la „puțin” s-a ajuns la „costisitor” și apoi la „drag”.",
      "source": "Etymological Dictionaries, Linguistic Analysis"
    }
  },
  "examples": [
    {
      "text": "Mașina este prea scumpă."
    },
