    "genus": "neuter",
    "etymology": {
      "text": "Românescul „loc” provine din latinescul „locus” („loc, poziție”) – aceeași rădăcină ca în „local”.",
      "source": "Etymological Dictionaries, Linguistic Analysis"
    }
  },
