  "data": {
    "headword": "pajiște",
    "definition": "O suprafață deschisă acoperită cu iarbă, folosită adesea pentru pășunat sau recreere.",
    "pronunciation": "/paˈʒiʃ.te/",
    "etymology": {
      "text": "Substantivul „pajiște” provine din slavă, din „pažitĭ” („pășune”).",
      "source": "Etymological Dictionaries, Linguistic Analysis"
    },
    "genus": "feminine"
  },
  "examples": [
    {
      "text": "Vaci pasc pe pajiște."
    },
    {
      "text": "Am făcut un picnic pe pajiștea însorită."
    },
    {
      "text": "Primăvara înfloresc multe flori pe pajiște."
    },
    {
      "text": "Copiii se joacă fotbal pe pajiște."
    },
    {
      "text": "Pajiștea este verde și fragedă după ploaie."
    }
