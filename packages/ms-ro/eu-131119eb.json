  "data": {
    "headword": "eu",
    "definition": "Pronumele personal de persoana întâi singular; desemnează persoana care vorbește.",
    "pronunciation": "/jew/",
    "etymology": {
      "text": "Românescul „eu” provine direct din latinescul „ego”; e- inițial a fost diftongat în [je], de unde pronunția /jew/ deși se scrie „eu”.",
      "source": "Etymological Dictionaries, Linguistic Analysis"
    }
  },
  "examples": [
    {
      "text": "Eu sunt acasă."
    },
    {
      "text": "Eu am o carte."
    },
    {
      "text": "Eu merg la școală."
    },
    {
