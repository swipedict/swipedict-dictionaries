  "data": {
    "headword": "apă",
    "definition": "Lichid incolor și inodor pe care îl bem și care formează râurile, lacurile și mările.",
    "pronunciation": "/ˈa.pə/",
    "genus": "feminine",
    "etymology": {
      "text": "Românescul „apă” provine din latinescul „aqua”; grupul latin -qu- a devenit regulat -p- în română, ca în „patru” < „quattuor”.",
      "source": "Etymological Dictionaries, Linguistic Analysis"
    }
  },
  "examples": [
