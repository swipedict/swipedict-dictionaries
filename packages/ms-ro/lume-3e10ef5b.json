  "data": {
    "headword": "lume",
    "definition": "Pământul cu tot ce există pe el; de asemenea, sfera vieții omenești.",
    "pronunciation": "/ˈlu.me/",
    "genus": "feminine",
    "etymology": {
      "text": "Românescul „lume” provine din latinescul „lumen” („lumină”). Prin expresia creștină „a veni pe lume”, sensul s-a deplasat de la „lumină” la „lume, oameni”.",
      "source": "Etymological Dictionaries, Linguistic Analysis"
    }
  },
  "examples": [
    {
      "text": "Lumea este mare."
    },
    {
      "text": "Vrea să vadă lumea."
    },
    {
      "text": "În toată lumea."
    },
    {
      "text": "Era multă lume acolo."
    }
  ],
