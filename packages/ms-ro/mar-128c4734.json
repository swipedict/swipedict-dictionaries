  "data": {
    "headword": "măr",
    "definition": "Fruct rotund de pom, de obicei roșu sau verde.",
    "pronunciation": "/mər/",
    "genus": "neuter",
    "etymology": {
      "text": "Românescul „măr” provine din latinescul „melum” (clasic „malum”, măr), împrumutat la rândul lui din greacă.",
      "source": "Etymological Dictionaries, Linguistic Analysis"
    }
  },
  "examples": [
    {
      "text": "Mănânc un măr."
    },
    {
