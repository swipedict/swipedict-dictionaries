  "data": {
    "headword": "mai puțin",
    "definition": "O cantitate mai mică sau un grad mai scăzut.",
    "pronunciation": "/maj puˈt͡sin/",
    "etymology": {
      "text": "Construcția leagă „mai” (din latinescul „magis”) cu „puțin” (din „putinnus”, mic).",
      "source": "Etymological Dictionaries, Linguistic Analysis"
    }
  },
  "examples": [
    {
      "text": "Mai puțin zahăr, vă rog."
    },
    {
      "text": "El muncește mai puțin."
    },
    {
      "text": "Mai puțin înseamnă mai mult."
    },
    {
      "text": "Nu mai puțin de zece."
