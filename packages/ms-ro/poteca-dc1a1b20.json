  "data": {
    "headword": "potecă",
    "definition": "Un drum îngust, de obicei în natură, folosit pentru mers pe jos sau drumeții.",
    "pronunciation": "/poˈte.kə/",
    "etymology": {
      "text": "Substantivul „potecă” provine din slavă, din „potĭka”.",
      "source": "Etymological Dictionaries, Linguistic Analysis"
    },
    "genus": "feminine"
  },
  "examples": [
    {
      "text": "Poteca trece prin pădure."
    },
    {
      "text": "Am urmat poteca până la râu."
    },
    {
      "text": "Poteca îngustă poate fi parcursă doar pe jos."
    },
    {
      "text": "Pe potecă cresc multe flori."
    }
