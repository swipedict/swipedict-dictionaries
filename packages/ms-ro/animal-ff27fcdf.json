  "data": {
    "headword": "animal",
    "definition": "Ființă vie care se poate mișca și care nu este nici om, nici plantă.",
    "pronunciation": "/a.niˈmal/",
    "genus": "neuter",
    "etymology": {
      "text": "Românescul „animal” este un împrumut cult din franceză („animal”); rădăcina este latinescul „anima” („suflare, suflet”) – animalul este ființa însuflețită.",
      "source": "Etymological Dictionaries, Linguistic Analysis"
    }
  },
  "examples": [
    {
      "text": "Câinele este un animal."
    },
    {
      "text": "Sunt multe animale."
    },
    {
      "text": "Animalele sălbatice trăiesc în pădure."
    },
    {
      "text": "Ea iubește animalele."
