    "headword": "șnur",
    "definition": "o bucată lungă și subțire de material, care este adesea folosită pentru a lega sau agăța",
    "pronunciation": "/ʃnur/",
    "etymology": {
      "text": "Substantivul „șnur” este împrumutat din germană, din „Schnur”.",
      "source": "Etymological Dictionaries, Linguistic Analysis"
    },
    "genus": "masculine"
  },
  "examples": [
    {
