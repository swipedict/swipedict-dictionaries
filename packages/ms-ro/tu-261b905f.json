  "data": {
    "headword": "tu",
    "definition": "Pronumele personal de persoana a doua singular; desemnează persoana căreia i se vorbește.",
    "pronunciation": "/tu/",
    "etymology": {
      "text": "Românescul „tu” continuă neschimbat latinescul „tu” – unul dintre puținele cuvinte care și-au păstrat forma timp de două milenii.",
      "source": "Etymological Dictionaries, Linguistic Analysis"
    }
  },
  "examples": [
    {
      "text": "Tu ești acasă?"
    },
    {
      "text": "Tu ai dreptate."
    },
    {
      "text": "Tu vii cu mine?"
    },
    {
      "text": "Tu și eu vorbim româna."
