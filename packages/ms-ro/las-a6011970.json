  "data": {
    "headword": "laș",
    "definition": "eine Person, die mutlos oder ängstlich ist",
    "pronunciation": "/laʃ/",
    "etymology": {
      "text": "Adjectivul „laș” este împrumutat din franceză, din „lâche”.",
      "source": "Etymological Dictionaries, Linguistic Analysis"
    },
    "genus": "masculine"
  },
  "examples": [
    {
      "text": "Este prea laș ca să își exprime opinia."
    },
    {
      "text": "Oamenii lași nu îndrăznesc de obicei să își asume riscuri."
    },
    {
      "text": "Nimeni nu apreciază deciziile lașe."
    },
    {
      "text": "Este laș să fugi când devine greu."
    },
    {
      "text": "Uneori trebuie să trecem peste fricile noastre lașe."
    },
    {
      "text": "O decizie lașă nu este niciodată corectă."
    }
  ],
