  "data": {
    "headword": "gât",
    "definition": "Partea corpului care leagă capul de trunchi, prin care trec esofagul și traheea.",
    "pronunciation": "/ɡət/",
    "etymology": {
      "text": "Substantivul „gât” provine din slavă, din „glŭtŭ” („înghițitură, gâtlej”).",
      "source": "Etymological Dictionaries, Linguistic Analysis"
    },
    "genus": "neuter"
  },
  "examples": [
    {
      "text": "Are gâtul roșu din cauza vântului rece."
    },
    {
      "text": "Gâtul leagă capul de corp."
    },
    {
      "text": "Ea poartă un colier de aur."
    },
    {
      "text": "Doctorul i-a palpat gâtul pentru a verifica ganglionii limfatici."
    }
  ],
