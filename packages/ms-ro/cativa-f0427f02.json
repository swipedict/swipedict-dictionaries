  "data": {
    "headword": "câțiva",
    "definition": "Un număr nedeterminat, dar mic, de persoane sau lucruri.",
    "pronunciation": "/kɨˈt͡si.va/",
    "etymology": {
      "text": "Românescul „câțiva” este format din „câți” (din latinescul „quanti”) și particula „-va”.",
      "source": "Etymological Dictionaries, Linguistic Analysis"
    }
  },
  "examples": [
    {
      "text": "Câțiva prieteni vin."
    },
    {
      "text": "Am nevoie de câteva minute."
    },
    {
      "text": "După câteva zile."
    },
    {
      "text": "Câțiva au plecat deja."
    }
