  "data": {
    "headword": "pește",
    "definition": "Animal acvatic vertebrat, cu solzi și înotătoare, care respiră prin branhii.",
    "pronunciation": "/ˈpeʃ.te/",
    "genus": "masculine",
    "etymology": {
      "text": "Românescul „pește” provine din latinescul „piscis”; grupul latin -sc- urmat de vocală anterioară a dat regulat -șt- în română, ca în „a cunoaște” < „cognoscere”.",
      "source": "Etymological Dictionaries, Linguistic Analysis"
    }
  },
  "examples": [
    {
      "text": "Peștele înoată în apă."
    },
    {
      "text": "Mănânc pește la prânz."
    },
    {
      "text": "Am prins doi pești."
    },
    {
      "text": "Peștele este proaspăt."
    }
  ],
