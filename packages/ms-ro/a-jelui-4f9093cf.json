  "data": {
    "headword": "a jelui",
    "definition": "A exprima durere profundă și tristețe din cauza unei pierderi sau nenorociri.",
    "pronunciation": "/a jeˈlu.i/",
    "etymology": {
      "text": "Verbul „a jelui” provine din slavă, din „želovati” („a jeli, a se plânge”).",
      "source": "Etymological Dictionaries, Linguistic Analysis"
    }
  },
  "examples": [
    {
      "text": "Eu jelesc după bunicul meu."
    },
    {
      "text": "Mulți oameni jelesc după o pierdere."
    },
    {
      "text": "Ea jeleste de luni de zile după prietenul ei."
    },
    {
      "text": "Jelim împreună victimele."
    },
    {
      "text": "El a jeluit în tăcere și retras."
    }
  ],
