  "data": {
    "headword": "hartă",
    "definition": "Reprezentare plană, de obicei pe hârtie sau digitală, a unei zone geografice, folosită pentru orientare și planificare.",
    "pronunciation": "/ˈhartə/",
    "etymology": {
      "text": "Substantivul „hartă” provine din greaca modernă, de la „chartis” („hârtie, hartă”).",
      "source": "Etymological Dictionaries, Linguistic Analysis"
    },
    "genus": "feminine"
  },
  "examples": [
    {
      "text": "Am cumpărat o hartă a Europei."
    },
    {
      "text": "Harta arată toate orașele importante."
    },
    {
      "text": "Folosim harta pentru a găsi drumul."
    },
    {
      "text": "Pe hartă sunt marcate râuri și munți."
    },
    {
      "text": "Harta digitală este foarte detaliată."
    }
