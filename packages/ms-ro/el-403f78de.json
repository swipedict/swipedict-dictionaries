  "data": {
    "headword": "el",
    "definition": "Pronumele personal de persoana a treia singular, masculin.",
    "pronunciation": "/jel/",
    "etymology": {
      "text": "Românescul „el” provine din latinescul „ille” („acela”); din același cuvânt s-a dezvoltat și articolul hotărât -l din „omul”.",
      "source": "Etymological Dictionaries, Linguistic Analysis"
    }
  },
  "examples": [
