    "headword": "a îngriji",
    "definition": "a se ocupa de cineva sau a-l sprijini",
    "pronunciation": "/a ɨn.griˈʒi/",
    "etymology": {
      "text": "Verbul „a îngriji” este format de la „grijă”, împrumutat din slavonă, din „griža” („grijă, neliniște”).",
      "source": "Etymological Dictionaries, Linguistic Analysis"
    }
  },
  "examples": [
    {
      "text": "Eu îngrijesc elevii noi."
    },
    {
      "text": "Îngrijești hainele pentru eveniment?"
    },
    {
      "text": "El îngrijește bunicii săi."
    },
    {
      "text": "Noi îngrijim cu plăcere copiii din grădiniță."
    },
    {
      "text": "Îngrijiți animalele din grădina zoologică?"
    },
    {
      "text": "Ei îngrijesc foarte bine clienții."
    },
    {
      "text": "Am îngrijit copiii pe parcursul călătoriei."
    },
    {
      "text": "Ei îngrijeau oaspeții în timpul petrecerii."
    },
    {
      "text": "Voi îngriji animalele din adăpost."
    },
    {
      "text": "Aș îngriji angajații, dacă aș avea timp."
    }
