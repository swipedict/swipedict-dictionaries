  "data": {
    "headword": "Poftă bună",
    "definition": "Urmarea unei formule politicoase adresate înainte de masă pentru a ura plăcerea de a mânca.",
    "pronunciation": "/ˈpoftə ˈbuna/",
    "etymology": {
      "text": "Expresia conține „poftă”, împrumutat din slavonă, din „pohotĭ” („dorință”).",
      "source": "Etymological Dictionaries, Linguistic Analysis"
    }
  },
  "examples": [
    {
      "text": "Înainte de masă se spune adesea: Poftă bună!"
    },
    {
      "text": "Poftă bună! Mâncarea arată delicioasă."
    },
    {
      "text": "Îți doresc poftă bună și o seară plăcută."
    },
    {
      "text": "Poftă bună! Să-ți fie de bine."
    }
  ],
