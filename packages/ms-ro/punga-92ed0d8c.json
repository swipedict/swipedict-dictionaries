  "data": {
    "headword": "pungă",
    "definition": "Un săculeț subțire, de obicei din hârtie sau plastic, folosit pentru a transporta sau ambala obiecte.",
    "pronunciation": "/ˈpuŋɡə/",
    "etymology": {
      "text": "Substantivul „pungă” provine din greaca medievală, de la „pungi”.",
      "source": "Etymological Dictionaries, Linguistic Analysis"
    },
    "genus": "feminine"
  },
  "examples": [
    {
      "text": "Cumpăr pâine și o pun într-o pungă."
    },
    {
      "text": "Punga este făcută din plastic subțire."
    },
    {
      "text": "Îmi poți da, te rog, o pungă?"
    },
    {
      "text": "Punga este plină cu mere."
    }
