  "data": {
    "headword": "dragă",
    "definition": "Formă de adresare afectuoasă pentru o persoană iubită, echivalentul germanului 'Schatz' als Kosewort.",
    "pronunciation": "/ˈdraɡə/",
    "etymology": {
      "text": "Adjectivul „drag” provine din slavona veche „dragŭ” („drag, scump”).",
      "source": "Etymological Dictionaries, Linguistic Analysis"
    },
    "genus": "feminine"
  },
  "examples": [
    {
      "text": "Bună, dragă! Cum a fost ziua ta?"
    },
    {
      "text": "Dragă, mă poți ajuta, te rog?"
    },
    {
      "text": "Bună dimineața, dragul meu!"
    },
    {
      "text": "Te iubesc, dragă."
    }
  ],
