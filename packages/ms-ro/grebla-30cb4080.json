  "data": {
    "headword": "greblă",
    "definition": "Unealtă de grădină cu dinți folosită pentru a aduna frunze, pământ sau alte materiale.",
    "pronunciation": "/ˈɡreblə/",
    "etymology": {
      "text": "Substantivul „greblă” provine din slavă, din „greblo”.",
      "source": "Etymological Dictionaries, Linguistic Analysis"
    },
    "genus": "feminine"
  },
  "examples": [
    {
      "text": "Folosesc grebla pentru a aduna frunzele din grădină."
    },
    {
      "text": "Grebla are mulți dinți pentru a funcționa bine."
    },
    {
      "text": "După cositul ierbii, strâng iarba cu grebla."
    },
    {
      "text": "Grebla este o unealtă importantă de grădinărit toamna."
    }
