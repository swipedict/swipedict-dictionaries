  "data": {
    "headword": "ciocan",
    "definition": "Unealtă cu cap greu, de obicei din metal, folosită pentru a bate cuie sau a sparge obiecte.",
    "pronunciation": "/t͡ʃoˈkan/",
    "etymology": {
      "text": "Substantivul „ciocan” provine din slavă, din „čekanŭ”.",
      "source": "Etymological Dictionaries, Linguistic Analysis"
    },
    "genus": "neuter"
  },
  "examples": [
    {
      "text": "Folosesc un ciocan pentru a bate cuiul."
    },
    {
      "text": "Ciocanul este o unealtă indispensabilă în atelier."
    },
    {
      "text": "Și-a lovit degetul mare cu ciocanul."
    },
    {
      "text": "Ciocanul are un cap greu de metal și un mâner de lemn."
    }
  ],
