  "data": {
    "headword": "chirie",
    "definition": "Suma de bani plătită periodic pentru folosirea unei locuințe sau a unui spațiu.",
    "pronunciation": "/kiˈri.e/",
    "etymology": {
      "text": "Substantivul „chirie” este împrumutat din turcă, din „kira”.",
      "source": "Etymological Dictionaries, Linguistic Analysis"
    },
    "genus": "feminine"
  },
  "examples": [
    {
      "text": "Chiria pentru apartament se plătește în fiecare lună."
    },
    {
      "text": "El plătește chiria la timp."
    },
    {
      "text": "Chiria a fost mărită."
    },
    {
      "text": "În contractul de închiriere sunt toate condițiile."
    },
    {
      "text": "Mulți oameni caută o chirie accesibilă."
