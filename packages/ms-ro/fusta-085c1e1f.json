  "data": {
    "headword": "fustă",
    "definition": "Piesă de îmbrăcăminte care acoperă partea inferioară a corpului, purtată în special de femei.",
    "pronunciation": "/ˈfus.tə/",
    "etymology": {
      "text": "Substantivul „fustă” provine din greaca modernă, de la „fousta”.",
      "source": "Etymological Dictionaries, Linguistic Analysis"
    },
    "genus": "feminine"
  },
  "examples": [
    {
      "text": "Ea poartă o fustă roșie la petrecere."
    },
    {
      "text": "Fusta este din bumbac și foarte comodă."
    },
    {
      "text": "În vară îmi place să port fuste scurte."
    },
    {
      "text": "Fusta ajunge până la genunchi."
    }
