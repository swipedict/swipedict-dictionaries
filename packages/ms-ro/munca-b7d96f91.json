  "data": {
    "headword": "muncă",
    "definition": "Activitate fizică sau intelectuală cu un scop, adesea remunerată.",
    "pronunciation": "/ˈmun.kə/",
    "genus": "feminine",
    "etymology": {
      "text": "Românescul „muncă” este un împrumut slav, din slavona veche „mǫka” („chin, caznă”). Evoluția de la „chin” la „muncă” este paralelă cu cea a germanului „Arbeit”.",
      "source": "Etymological Dictionaries, Linguistic Analysis"
    }
  },
  "examples": [
    {
      "text": "Munca îmi place."
    },
    {
      "text": "Merg la muncă."
    },
    {
      "text": "A fost o muncă grea."
    },
    {
      "text": "El caută de muncă."
