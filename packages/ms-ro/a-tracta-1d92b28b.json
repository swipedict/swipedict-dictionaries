  "data": {
    "headword": "a tracta",
    "definition": "A trage un vehicul sau obiect cu un alt vehicul, de obicei pentru transport sau îndepărtare.",
    "pronunciation": "/a trakˈta/",
    "etymology": {
      "text": "Verbul „a tracta” este împrumutat din franceză, din „tracter” („a remorca”).",
      "source": "Etymological Dictionaries, Linguistic Analysis"
    }
  },
  "examples": [
    {
      "text": "Am tractat mașina stricată."
    },
    {
      "text": "Serviciul de tractare a tractat vehiculul."
    },
    {
      "text": "Trebuie să tractăm mașina pentru că nu mai merge."
    },
    {
      "text": "El a tractat remorca după el."
    }
  ],
