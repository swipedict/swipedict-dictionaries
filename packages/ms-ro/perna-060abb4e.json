  "data": {
    "headword": "pernă",
    "definition": "Un obiect moale folosit pentru a sprijini capul sau alte părți ale corpului, de obicei umplut cu materiale moi.",
    "pronunciation": "/perˈnə/",
    "etymology": {
      "text": "Substantivul „pernă” provine din slavă, din „perina” („saltea de pene”).",
      "source": "Etymological Dictionaries, Linguistic Analysis"
    },
    "genus": "feminine"
  },
  "examples": [
    {
      "text": "Îmi pun capul pe pernă."
    },
    {
      "text": "Perna este foarte moale și confortabilă."
    },
    {
      "text": "Ea a cumpărat perne noi pentru canapea."
    },
    {
      "text": "Perna ajută la somn sprijinind gâtul."
    }
  ],
