  "data": {
    "headword": "a supăra",
    "definition": "a ofensa sau a irita pe cineva",
    "pronunciation": "/a suˈpəra/",
    "etymology": {
      "text": "Verbul „a supăra” provine din latinescul „superare” („a birui, a copleși”); sensul a evoluat spre „a mâhni, a irita”.",
      "source": "Etymological Dictionaries, Linguistic Analysis"
    }
  },
  "examples": [
    {
      "text": "Mă supără vremea rea."
    },
    {
      "text": "Nu te supăra de lucruri mărunte!"
    },
    {
      "text": "El se supără din cauza întârzierii."
    },
    {
      "text": "Ne supărăm adesea din cauza traficului."
    },
    {
      "text": "Nu vă supărați din cauza rezultatului!"
    },
    {
      "text": "Ei se supără din cauza întreruperilor constante."
    },
    {
      "text": "M-am supărat ieri."
    },
    {
      "text": "El se supăra adesea pe vecinul său."
    },
    {
      "text": "Nu mă voi mai supăra."
    },
    {
      "text": "Nu m-aș supăra dacă te-aș avea."
    },
    {
      "text": "Nu te supăra!"
    }
