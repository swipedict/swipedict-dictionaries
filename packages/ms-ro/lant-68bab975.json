  "data": {
    "headword": "lanț",
    "definition": "O succesiune de verigi legate între ele, de obicei din metal, folosită ca podoabă sau pentru fixare.",
    "pronunciation": "/lant͡s/",
    "etymology": {
      "text": "Substantivul „lanț” provine din slavă, din „lancuchŭ”.",
      "source": "Etymological Dictionaries, Linguistic Analysis"
    },
    "genus": "neuter"
  },
  "examples": [
    {
      "text": "Lanțul bicicletei s-a rupt."
    },
    {
      "text": "Ea poartă un lanț de aur la gât."
    },
    {
      "text": "Lanțul leagă verigile între ele."
    },
    {
      "text": "El a fixat lanțul de poartă."
    }
  ],
