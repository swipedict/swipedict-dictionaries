    "genus": "feminine",
    "etymology": {
      "text": "Românescul „față” provine din latinescul popular „facia” (clasic „facies”); grupul -ci- a devenit -ț-, ca în „brațe” < „bracchia”.",
      "source": "Etymological Dictionaries, Linguistic Analysis"
    }
  },
