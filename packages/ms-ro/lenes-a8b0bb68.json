    "headword": "leneș",
    "definition": "care evită efortul, este lipsit de energie sau activitate",
    "pronunciation": "/le'neʃ/",
    "etymology": {
      "text": "Adjectivul „leneș” este format de la „lene”, împrumutat din slavă, din „lěnŭ”.",
      "source": "Etymological Dictionaries, Linguistic Analysis"
    },
    "genus": "masculine"
  },
  "examples": [
    {
      "text": "În zilele leneșe nu sunt niciodată cu adevărat productiv."
    },
    {
      "text": "Se simțea epuizată și obosită în această zi leneșă."
    },
    {
      "text": "A lăsat o impresie leneșă."
    },
    {
      "text": "Mișcarea leneșă a planului a fost observată de toți."
    },
    {
      "text": "Sunt adesea leneș când plouă afară."
    },
    {
      "text": "S-a arătat leneș la muncă."
    }
