  "data": {
    "headword": "stâncă",
    "definition": "O piatră mare și masivă sau o formațiune stâncoasă care apare natural în peisaj.",
    "pronunciation": "/stɨnˈkə/",
    "etymology": {
      "text": "Substantivul „stâncă” provine din slavă, din „stěna” („perete de piatră”).",
      "source": "Etymological Dictionaries, Linguistic Analysis"
    },
    "genus": "feminine"
  },
  "examples": [
    {
      "text": "Stânca de la mare este foarte mare."
    },
    {
      "text": "Am urcat pe stâncă."
    },
    {
      "text": "Stânca protejează coasta de valurile puternice."
    },
    {
      "text": "Multe plante cresc pe stâncă."
    }
