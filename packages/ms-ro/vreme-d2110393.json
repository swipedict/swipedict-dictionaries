  "data": {
    "headword": "vreme",
    "definition": "Starea atmosferei într-un anumit loc și moment, în special referitoare la temperatură, precipitații, vânt și nori.",
    "pronunciation": "/ˈvre.me/",
    "etymology": {
      "text": "Substantivul „vreme” provine din slavona veche „vremę” („timp”).",
      "source": "Etymological Dictionaries, Linguistic Analysis"
    },
    "genus": "feminine"
  },
  "examples": [
    {
      "text": "Vremea este astăzi însorită și caldă."
    },
    {
      "text": "Iarna vremea este adesea rece și umedă."
    },
    {
      "text": "Vremea se poate schimba rapid."
    },
    {
      "text": "Ar trebui să urmărim vremea înainte să ieșim afară."
    }
