  "data": {
    "headword": "obraj",
    "definition": "Partea laterală a feței, situată sub ochi, care formează obrazul.",
    "pronunciation": "/oˈbraʒ/",
    "etymology": {
      "text": "Substantivul „obraz” provine din slavona veche „obrazŭ” („chip, față”).",
      "source": "Etymological Dictionaries, Linguistic Analysis"
    },
    "genus": "masculine"
  },
  "examples": [
    {
      "text": "Are un obraz roșu pentru că a stat afară în frig."
    },
    {
      "text": "Bebelușul i-a sărutat obrazul mamei."
    },
    {
      "text": "Și-a șters obrazul după ce a transpirat."
    },
    {
      "text": "Obrajii se înroșesc adesea când cineva se înroșește."
    }
