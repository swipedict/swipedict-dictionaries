  "data": {
    "headword": "niciun",
    "definition": "Cuvânt de negație care însoțește un substantiv: nici măcar unul.",
    "pronunciation": "/ni.t͡ʃiˈun/",
    "etymology": {
      "text": "Românescul „niciun” este compus din „nici” (din latinescul „neque”) și „un” (din „unus”).",
      "source": "Etymological Dictionaries, Linguistic Analysis"
    }
  },
  "examples": [
    {
      "text": "Nu am niciun ban."
    },
    {
      "text": "Nicio problemă."
    },
    {
      "text": "Nu a spus niciun cuvânt."
    },
    {
      "text": "Niciun elev nu a lipsit."
